<div class="title text-center">
  List of AdSlots
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">slotCode</th>
			<th style="text-align:center">width</th>
			<th style="text-align:center">height</th>
			<th style="text-align:center">floorPrice</th>
			<th style="text-align:center">Format</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @adSlots.each do |adSlot| %>
		<tr>   
			<td style="text-align:center">
	  			<%= adSlot.slotCode %>
			</td>
			<td style="text-align:center">
	  			<%= adSlot.width %>
			</td>
			<td style="text-align:center">
	  			<%= adSlot.height %>
			</td>
			<td style="text-align:center">
	  			<%= adSlot.floorPrice %>
			</td>
			<td style="text-align:center">
	  			<%= adSlot.Format %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_adSlot_path(adSlot), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', adSlot_path(adSlot), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AdSlot', new_adSlot_path, :method => :get, :class => "btn btn-success btn-sm" %>