<div class="title text-center">
  List of Advertisers
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">legalName</th>
			<th style="text-align:center">industry</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @advertisers.each do |advertiser| %>
		<tr>   
			<td style="text-align:center">
	  			<%= advertiser.name %>
			</td>
			<td style="text-align:center">
	  			<%= advertiser.legalName %>
			</td>
			<td style="text-align:center">
	  			<%= advertiser.industry %>
			</td>
			<td style="text-align:center">
	  			<%= advertiser.website %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_advertiser_path(advertiser), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', advertiser_path(advertiser), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Advertiser', new_advertiser_path, :method => :get, :class => "btn btn-success btn-sm" %>