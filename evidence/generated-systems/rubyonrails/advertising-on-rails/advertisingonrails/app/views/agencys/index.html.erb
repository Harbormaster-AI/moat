<div class="title text-center">
  List of Agencys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">legalName</th>
			<th style="text-align:center">headquartersCountry</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @agencys.each do |agency| %>
		<tr>   
			<td style="text-align:center">
	  			<%= agency.name %>
			</td>
			<td style="text-align:center">
	  			<%= agency.legalName %>
			</td>
			<td style="text-align:center">
	  			<%= agency.headquartersCountry %>
			</td>
			<td style="text-align:center">
	  			<%= agency.website %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_agency_path(agency), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', agency_path(agency), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Agency', new_agency_path, :method => :get, :class => "btn btn-success btn-sm" %>