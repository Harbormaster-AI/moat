<div class="title text-center">
  List of Campaigns
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">totalBudget</th>
			<th style="text-align:center">flight</th>
			<th style="text-align:center">Objective</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @campaigns.each do |campaign| %>
		<tr>   
			<td style="text-align:center">
	  			<%= campaign.name %>
			</td>
			<td style="text-align:center">
	  			<%= campaign.totalBudget %>
			</td>
			<td style="text-align:center">
	  			<%= campaign.flight %>
			</td>
			<td style="text-align:center">
	  			<%= campaign.Objective %>
			</td>
			<td style="text-align:center">
	  			<%= campaign.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_campaign_path(campaign), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', campaign_path(campaign), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Campaign', new_campaign_path, :method => :get, :class => "btn btn-success btn-sm" %>