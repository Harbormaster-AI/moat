<div class="title text-center">
  List of ContentCategorys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">code</th>
			<th style="text-align:center">name</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @contentCategorys.each do |contentCategory| %>
		<tr>   
			<td style="text-align:center">
	  			<%= contentCategory.code %>
			</td>
			<td style="text-align:center">
	  			<%= contentCategory.name %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_contentCategory_path(contentCategory), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', contentCategory_path(contentCategory), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ContentCategory', new_contentCategory_path, :method => :get, :class => "btn btn-success btn-sm" %>