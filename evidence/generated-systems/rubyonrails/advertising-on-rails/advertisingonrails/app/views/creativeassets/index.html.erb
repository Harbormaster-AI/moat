<div class="title text-center">
  List of CreativeAssets
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">clickUrl</th>
			<th style="text-align:center">landingPage</th>
			<th style="text-align:center">width</th>
			<th style="text-align:center">height</th>
			<th style="text-align:center">durationSeconds</th>
			<th style="text-align:center">CreativeType</th>
			<th style="text-align:center">AdFormat</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @creativeAssets.each do |creativeAsset| %>
		<tr>   
			<td style="text-align:center">
	  			<%= creativeAsset.name %>
			</td>
			<td style="text-align:center">
	  			<%= creativeAsset.clickUrl %>
			</td>
			<td style="text-align:center">
	  			<%= creativeAsset.landingPage %>
			</td>
			<td style="text-align:center">
	  			<%= creativeAsset.width %>
			</td>
			<td style="text-align:center">
	  			<%= creativeAsset.height %>
			</td>
			<td style="text-align:center">
	  			<%= creativeAsset.durationSeconds %>
			</td>
			<td style="text-align:center">
	  			<%= creativeAsset.CreativeType %>
			</td>
			<td style="text-align:center">
	  			<%= creativeAsset.AdFormat %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_creativeAsset_path(creativeAsset), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', creativeAsset_path(creativeAsset), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CreativeAsset', new_creativeAsset_path, :method => :get, :class => "btn btn-success btn-sm" %>