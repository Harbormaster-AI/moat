<div class="title text-center">
  List of CreativeVariations
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">language</th>
			<th style="text-align:center">headline</th>
			<th style="text-align:center">bodyText</th>
			<th style="text-align:center">callToAction</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @creativeVariations.each do |creativeVariation| %>
		<tr>   
			<td style="text-align:center">
	  			<%= creativeVariation.name %>
			</td>
			<td style="text-align:center">
	  			<%= creativeVariation.language %>
			</td>
			<td style="text-align:center">
	  			<%= creativeVariation.headline %>
			</td>
			<td style="text-align:center">
	  			<%= creativeVariation.bodyText %>
			</td>
			<td style="text-align:center">
	  			<%= creativeVariation.callToAction %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_creativeVariation_path(creativeVariation), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', creativeVariation_path(creativeVariation), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CreativeVariation', new_creativeVariation_path, :method => :get, :class => "btn btn-success btn-sm" %>