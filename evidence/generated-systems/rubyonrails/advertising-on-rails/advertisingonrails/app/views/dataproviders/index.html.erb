<div class="title text-center">
  List of DataProviders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center">ProviderType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dataProviders.each do |dataProvider| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dataProvider.name %>
			</td>
			<td style="text-align:center">
	  			<%= dataProvider.website %>
			</td>
			<td style="text-align:center">
	  			<%= dataProvider.ProviderType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dataProvider_path(dataProvider), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dataProvider_path(dataProvider), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DataProvider', new_dataProvider_path, :method => :get, :class => "btn btn-success btn-sm" %>