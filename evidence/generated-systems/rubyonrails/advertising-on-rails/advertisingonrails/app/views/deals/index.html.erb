<div class="title text-center">
  List of Deals
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">floorPrice</th>
			<th style="text-align:center">DealType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @deals.each do |deal| %>
		<tr>   
			<td style="text-align:center">
	  			<%= deal.floorPrice %>
			</td>
			<td style="text-align:center">
	  			<%= deal.DealType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_deal_path(deal), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', deal_path(deal), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Deal', new_deal_path, :method => :get, :class => "btn btn-success btn-sm" %>