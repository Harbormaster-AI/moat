<div class="title text-center">
  List of DSPs
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center">region</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dSPs.each do |dSP| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dSP.name %>
			</td>
			<td style="text-align:center">
	  			<%= dSP.website %>
			</td>
			<td style="text-align:center">
	  			<%= dSP.region %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dSP_path(dSP), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dSP_path(dSP), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DSP', new_dSP_path, :method => :get, :class => "btn btn-success btn-sm" %>