<div class="title text-center">
  List of Experiments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">hypothesis</th>
			<th style="text-align:center">startDate</th>
			<th style="text-align:center">endDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @experiments.each do |experiment| %>
		<tr>   
			<td style="text-align:center">
	  			<%= experiment.name %>
			</td>
			<td style="text-align:center">
	  			<%= experiment.hypothesis %>
			</td>
			<td style="text-align:center">
	  			<%= experiment.startDate %>
			</td>
			<td style="text-align:center">
	  			<%= experiment.endDate %>
			</td>
			<td style="text-align:center">
	  			<%= experiment.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_experiment_path(experiment), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', experiment_path(experiment), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Experiment', new_experiment_path, :method => :get, :class => "btn btn-success btn-sm" %>