<div class="title text-center">
  List of ExperimentVariants
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">allocation</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @experimentVariants.each do |experimentVariant| %>
		<tr>   
			<td style="text-align:center">
	  			<%= experimentVariant.name %>
			</td>
			<td style="text-align:center">
	  			<%= experimentVariant.allocation %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_experimentVariant_path(experimentVariant), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', experimentVariant_path(experimentVariant), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ExperimentVariant', new_experimentVariant_path, :method => :get, :class => "btn btn-success btn-sm" %>