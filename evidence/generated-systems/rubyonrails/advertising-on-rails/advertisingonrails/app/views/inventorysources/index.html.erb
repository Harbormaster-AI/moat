<div class="title text-center">
  List of InventorySources
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">domain</th>
			<th style="text-align:center">Channel</th>
			<th style="text-align:center">PrimaryFormat</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @inventorySources.each do |inventorySource| %>
		<tr>   
			<td style="text-align:center">
	  			<%= inventorySource.name %>
			</td>
			<td style="text-align:center">
	  			<%= inventorySource.domain %>
			</td>
			<td style="text-align:center">
	  			<%= inventorySource.Channel %>
			</td>
			<td style="text-align:center">
	  			<%= inventorySource.PrimaryFormat %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_inventorySource_path(inventorySource), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', inventorySource_path(inventorySource), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InventorySource', new_inventorySource_path, :method => :get, :class => "btn btn-success btn-sm" %>