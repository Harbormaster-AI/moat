<div class="title text-center">
  List of KPIs
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">targetValue</th>
			<th style="text-align:center">MetricType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @kPIs.each do |kPI| %>
		<tr>   
			<td style="text-align:center">
	  			<%= kPI.targetValue %>
			</td>
			<td style="text-align:center">
	  			<%= kPI.MetricType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_kPI_path(kPI), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', kPI_path(kPI), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New KPI', new_kPI_path, :method => :get, :class => "btn btn-success btn-sm" %>