<div class="title text-center">
  List of LineItems
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">bidAmount</th>
			<th style="text-align:center">dailyBudget</th>
			<th style="text-align:center">frequencyCap</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center">PricingModel</th>
			<th style="text-align:center">BidStrategy</th>
			<th style="text-align:center">Pacing</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @lineItems.each do |lineItem| %>
		<tr>   
			<td style="text-align:center">
	  			<%= lineItem.name %>
			</td>
			<td style="text-align:center">
	  			<%= lineItem.bidAmount %>
			</td>
			<td style="text-align:center">
	  			<%= lineItem.dailyBudget %>
			</td>
			<td style="text-align:center">
	  			<%= lineItem.frequencyCap %>
			</td>
			<td style="text-align:center">
	  			<%= lineItem.Status %>
			</td>
			<td style="text-align:center">
	  			<%= lineItem.PricingModel %>
			</td>
			<td style="text-align:center">
	  			<%= lineItem.BidStrategy %>
			</td>
			<td style="text-align:center">
	  			<%= lineItem.Pacing %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_lineItem_path(lineItem), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', lineItem_path(lineItem), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New LineItem', new_lineItem_path, :method => :get, :class => "btn btn-success btn-sm" %>