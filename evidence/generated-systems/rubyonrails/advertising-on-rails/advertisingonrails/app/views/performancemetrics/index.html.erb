<div class="title text-center">
  List of PerformanceMetrics
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">date</th>
			<th style="text-align:center">value</th>
			<th style="text-align:center">MetricType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @performanceMetrics.each do |performanceMetric| %>
		<tr>   
			<td style="text-align:center">
	  			<%= performanceMetric.date %>
			</td>
			<td style="text-align:center">
	  			<%= performanceMetric.value %>
			</td>
			<td style="text-align:center">
	  			<%= performanceMetric.MetricType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_performanceMetric_path(performanceMetric), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', performanceMetric_path(performanceMetric), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PerformanceMetric', new_performanceMetric_path, :method => :get, :class => "btn btn-success btn-sm" %>