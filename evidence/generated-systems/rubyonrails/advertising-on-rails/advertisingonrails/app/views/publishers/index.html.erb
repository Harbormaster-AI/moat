<div class="title text-center">
  List of Publishers
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center">PublisherType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @publishers.each do |publisher| %>
		<tr>   
			<td style="text-align:center">
	  			<%= publisher.name %>
			</td>
			<td style="text-align:center">
	  			<%= publisher.website %>
			</td>
			<td style="text-align:center">
	  			<%= publisher.PublisherType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_publisher_path(publisher), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', publisher_path(publisher), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Publisher', new_publisher_path, :method => :get, :class => "btn btn-success btn-sm" %>