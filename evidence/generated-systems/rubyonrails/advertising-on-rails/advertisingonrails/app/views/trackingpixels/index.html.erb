<div class="title text-center">
  List of TrackingPixels
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">url</th>
			<th style="text-align:center">EventType</th>
			<th style="text-align:center">PixelType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @trackingPixels.each do |trackingPixel| %>
		<tr>   
			<td style="text-align:center">
	  			<%= trackingPixel.name %>
			</td>
			<td style="text-align:center">
	  			<%= trackingPixel.url %>
			</td>
			<td style="text-align:center">
	  			<%= trackingPixel.EventType %>
			</td>
			<td style="text-align:center">
	  			<%= trackingPixel.PixelType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_trackingPixel_path(trackingPixel), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', trackingPixel_path(trackingPixel), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TrackingPixel', new_trackingPixel_path, :method => :get, :class => "btn btn-success btn-sm" %>