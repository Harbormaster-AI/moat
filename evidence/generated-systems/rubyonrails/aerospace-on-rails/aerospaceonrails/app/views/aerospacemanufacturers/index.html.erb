<div class="title text-center">
  List of AerospaceManufacturers
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">legalName</th>
			<th style="text-align:center">headquartersCountry</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aerospaceManufacturers.each do |aerospaceManufacturer| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aerospaceManufacturer.name %>
			</td>
			<td style="text-align:center">
	  			<%= aerospaceManufacturer.legalName %>
			</td>
			<td style="text-align:center">
	  			<%= aerospaceManufacturer.headquartersCountry %>
			</td>
			<td style="text-align:center">
	  			<%= aerospaceManufacturer.website %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aerospaceManufacturer_path(aerospaceManufacturer), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aerospaceManufacturer_path(aerospaceManufacturer), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AerospaceManufacturer', new_aerospaceManufacturer_path, :method => :get, :class => "btn btn-success btn-sm" %>