<div class="title text-center">
  List of AircraftFamilys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">familyCode</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aircraftFamilys.each do |aircraftFamily| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aircraftFamily.name %>
			</td>
			<td style="text-align:center">
	  			<%= aircraftFamily.familyCode %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aircraftFamily_path(aircraftFamily), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aircraftFamily_path(aircraftFamily), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AircraftFamily', new_aircraftFamily_path, :method => :get, :class => "btn btn-success btn-sm" %>