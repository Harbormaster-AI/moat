<div class="title text-center">
  List of AircraftModels
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">modelDesignation</th>
			<th style="text-align:center">AircraftType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aircraftModels.each do |aircraftModel| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aircraftModel.name %>
			</td>
			<td style="text-align:center">
	  			<%= aircraftModel.modelDesignation %>
			</td>
			<td style="text-align:center">
	  			<%= aircraftModel.AircraftType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aircraftModel_path(aircraftModel), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aircraftModel_path(aircraftModel), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AircraftModel', new_aircraftModel_path, :method => :get, :class => "btn btn-success btn-sm" %>