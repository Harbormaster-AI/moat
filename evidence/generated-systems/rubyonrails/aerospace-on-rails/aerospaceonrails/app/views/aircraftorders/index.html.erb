<div class="title text-center">
  List of AircraftOrders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">orderNumber</th>
			<th style="text-align:center">totalAmount</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aircraftOrders.each do |aircraftOrder| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aircraftOrder.orderNumber %>
			</td>
			<td style="text-align:center">
	  			<%= aircraftOrder.totalAmount %>
			</td>
			<td style="text-align:center">
	  			<%= aircraftOrder.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aircraftOrder_path(aircraftOrder), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aircraftOrder_path(aircraftOrder), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AircraftOrder', new_aircraftOrder_path, :method => :get, :class => "btn btn-success btn-sm" %>