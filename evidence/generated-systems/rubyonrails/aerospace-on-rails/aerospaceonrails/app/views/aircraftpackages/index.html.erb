<div class="title text-center">
  List of AircraftPackages
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">PackageType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aircraftPackages.each do |aircraftPackage| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aircraftPackage.name %>
			</td>
			<td style="text-align:center">
	  			<%= aircraftPackage.PackageType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aircraftPackage_path(aircraftPackage), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aircraftPackage_path(aircraftPackage), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AircraftPackage', new_aircraftPackage_path, :method => :get, :class => "btn btn-success btn-sm" %>