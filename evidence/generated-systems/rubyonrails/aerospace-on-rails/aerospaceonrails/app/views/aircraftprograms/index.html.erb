<div class="title text-center">
  List of AircraftPrograms
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">programCode</th>
			<th style="text-align:center">entryIntoServiceYear</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aircraftPrograms.each do |aircraftProgram| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aircraftProgram.name %>
			</td>
			<td style="text-align:center">
	  			<%= aircraftProgram.programCode %>
			</td>
			<td style="text-align:center">
	  			<%= aircraftProgram.entryIntoServiceYear %>
			</td>
			<td style="text-align:center">
	  			<%= aircraftProgram.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aircraftProgram_path(aircraftProgram), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aircraftProgram_path(aircraftProgram), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AircraftProgram', new_aircraftProgram_path, :method => :get, :class => "btn btn-success btn-sm" %>