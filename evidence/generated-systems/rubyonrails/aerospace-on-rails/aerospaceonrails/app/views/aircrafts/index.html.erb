<div class="title text-center">
  List of Aircrafts
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">msn</th>
			<th style="text-align:center">deliveryDate</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aircrafts.each do |aircraft| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aircraft.msn %>
			</td>
			<td style="text-align:center">
	  			<%= aircraft.deliveryDate %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aircraft_path(aircraft), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aircraft_path(aircraft), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Aircraft', new_aircraft_path, :method => :get, :class => "btn btn-success btn-sm" %>