<div class="title text-center">
  List of AirworthinessDirectives
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">directiveNumber</th>
			<th style="text-align:center">title</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @airworthinessDirectives.each do |airworthinessDirective| %>
		<tr>   
			<td style="text-align:center">
	  			<%= airworthinessDirective.directiveNumber %>
			</td>
			<td style="text-align:center">
	  			<%= airworthinessDirective.title %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_airworthinessDirective_path(airworthinessDirective), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', airworthinessDirective_path(airworthinessDirective), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AirworthinessDirective', new_airworthinessDirective_path, :method => :get, :class => "btn btn-success btn-sm" %>