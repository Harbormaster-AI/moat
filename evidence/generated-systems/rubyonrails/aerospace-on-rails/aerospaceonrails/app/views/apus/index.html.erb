<div class="title text-center">
  List of APUs
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">model</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aPUs.each do |aPU| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aPU.model %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aPU_path(aPU), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aPU_path(aPU), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New APU', new_aPU_path, :method => :get, :class => "btn btn-success btn-sm" %>