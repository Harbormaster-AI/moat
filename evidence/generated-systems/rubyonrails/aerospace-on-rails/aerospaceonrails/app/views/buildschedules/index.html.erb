<div class="title text-center">
  List of BuildSchedules
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">scheduleNumber</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @buildSchedules.each do |buildSchedule| %>
		<tr>   
			<td style="text-align:center">
	  			<%= buildSchedule.scheduleNumber %>
			</td>
			<td style="text-align:center">
	  			<%= buildSchedule.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_buildSchedule_path(buildSchedule), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', buildSchedule_path(buildSchedule), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New BuildSchedule', new_buildSchedule_path, :method => :get, :class => "btn btn-success btn-sm" %>