<div class="title text-center">
  List of ConnectedAircrafts
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">communicationsProvider</th>
			<th style="text-align:center">ConnectivityStatus</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @connectedAircrafts.each do |connectedAircraft| %>
		<tr>   
			<td style="text-align:center">
	  			<%= connectedAircraft.communicationsProvider %>
			</td>
			<td style="text-align:center">
	  			<%= connectedAircraft.ConnectivityStatus %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_connectedAircraft_path(connectedAircraft), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', connectedAircraft_path(connectedAircraft), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ConnectedAircraft', new_connectedAircraft_path, :method => :get, :class => "btn btn-success btn-sm" %>