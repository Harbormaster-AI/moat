<div class="title text-center">
  List of EngineTypes
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">engineModelCode</th>
			<th style="text-align:center">maxThrustKn</th>
			<th style="text-align:center">Category</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @engineTypes.each do |engineType| %>
		<tr>   
			<td style="text-align:center">
	  			<%= engineType.engineModelCode %>
			</td>
			<td style="text-align:center">
	  			<%= engineType.maxThrustKn %>
			</td>
			<td style="text-align:center">
	  			<%= engineType.Category %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_engineType_path(engineType), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', engineType_path(engineType), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New EngineType', new_engineType_path, :method => :get, :class => "btn btn-success btn-sm" %>