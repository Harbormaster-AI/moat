<div class="title text-center">
  List of FlightHealthEvents
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">eventCode</th>
			<th style="text-align:center">Severity</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @flightHealthEvents.each do |flightHealthEvent| %>
		<tr>   
			<td style="text-align:center">
	  			<%= flightHealthEvent.eventCode %>
			</td>
			<td style="text-align:center">
	  			<%= flightHealthEvent.Severity %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_flightHealthEvent_path(flightHealthEvent), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', flightHealthEvent_path(flightHealthEvent), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New FlightHealthEvent', new_flightHealthEvent_path, :method => :get, :class => "btn btn-success btn-sm" %>