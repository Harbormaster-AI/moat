<div class="title text-center">
  List of LandingGears
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">supplierPartNumber</th>
			<th style="text-align:center">GearType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @landingGears.each do |landingGear| %>
		<tr>   
			<td style="text-align:center">
	  			<%= landingGear.supplierPartNumber %>
			</td>
			<td style="text-align:center">
	  			<%= landingGear.GearType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_landingGear_path(landingGear), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', landingGear_path(landingGear), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New LandingGear', new_landingGear_path, :method => :get, :class => "btn btn-success btn-sm" %>