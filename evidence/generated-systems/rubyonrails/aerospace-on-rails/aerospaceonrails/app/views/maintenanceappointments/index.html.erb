<div class="title text-center">
  List of MaintenanceAppointments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">appointmentDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @maintenanceAppointments.each do |maintenanceAppointment| %>
		<tr>   
			<td style="text-align:center">
	  			<%= maintenanceAppointment.appointmentDate %>
			</td>
			<td style="text-align:center">
	  			<%= maintenanceAppointment.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_maintenanceAppointment_path(maintenanceAppointment), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', maintenanceAppointment_path(maintenanceAppointment), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New MaintenanceAppointment', new_maintenanceAppointment_path, :method => :get, :class => "btn btn-success btn-sm" %>