<div class="title text-center">
  List of MaintenanceWorkOrders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">workOrderNumber</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @maintenanceWorkOrders.each do |maintenanceWorkOrder| %>
		<tr>   
			<td style="text-align:center">
	  			<%= maintenanceWorkOrder.workOrderNumber %>
			</td>
			<td style="text-align:center">
	  			<%= maintenanceWorkOrder.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_maintenanceWorkOrder_path(maintenanceWorkOrder), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', maintenanceWorkOrder_path(maintenanceWorkOrder), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New MaintenanceWorkOrder', new_maintenanceWorkOrder_path, :method => :get, :class => "btn btn-success btn-sm" %>