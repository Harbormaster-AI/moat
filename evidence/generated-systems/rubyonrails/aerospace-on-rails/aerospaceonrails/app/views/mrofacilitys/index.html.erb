<div class="title text-center">
  List of MROFacilitys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">approvalScope</th>
			<th style="text-align:center">address</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @mROFacilitys.each do |mROFacility| %>
		<tr>   
			<td style="text-align:center">
	  			<%= mROFacility.name %>
			</td>
			<td style="text-align:center">
	  			<%= mROFacility.approvalScope %>
			</td>
			<td style="text-align:center">
	  			<%= mROFacility.address %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_mROFacility_path(mROFacility), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', mROFacility_path(mROFacility), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New MROFacility', new_mROFacility_path, :method => :get, :class => "btn btn-success btn-sm" %>