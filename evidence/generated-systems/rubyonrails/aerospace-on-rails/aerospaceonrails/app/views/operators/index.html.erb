<div class="title text-center">
  List of Operators
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">icaoDesignator</th>
			<th style="text-align:center">OperatorType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @operators.each do |operator| %>
		<tr>   
			<td style="text-align:center">
	  			<%= operator.name %>
			</td>
			<td style="text-align:center">
	  			<%= operator.icaoDesignator %>
			</td>
			<td style="text-align:center">
	  			<%= operator.OperatorType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_operator_path(operator), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', operator_path(operator), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Operator', new_operator_path, :method => :get, :class => "btn btn-success btn-sm" %>