<div class="title text-center">
  List of ProductionCertificates
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">certificateNumber</th>
			<th style="text-align:center">authority</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @productionCertificates.each do |productionCertificate| %>
		<tr>   
			<td style="text-align:center">
	  			<%= productionCertificate.certificateNumber %>
			</td>
			<td style="text-align:center">
	  			<%= productionCertificate.authority %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_productionCertificate_path(productionCertificate), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', productionCertificate_path(productionCertificate), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ProductionCertificate', new_productionCertificate_path, :method => :get, :class => "btn btn-success btn-sm" %>