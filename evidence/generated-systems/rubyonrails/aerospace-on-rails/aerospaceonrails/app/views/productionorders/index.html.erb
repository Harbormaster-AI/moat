<div class="title text-center">
  List of ProductionOrders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">orderNumber</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @productionOrders.each do |productionOrder| %>
		<tr>   
			<td style="text-align:center">
	  			<%= productionOrder.orderNumber %>
			</td>
			<td style="text-align:center">
	  			<%= productionOrder.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_productionOrder_path(productionOrder), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', productionOrder_path(productionOrder), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ProductionOrder', new_productionOrder_path, :method => :get, :class => "btn btn-success btn-sm" %>