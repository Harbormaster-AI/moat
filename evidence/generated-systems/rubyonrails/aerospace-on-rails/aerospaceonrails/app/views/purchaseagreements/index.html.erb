<div class="title text-center">
  List of PurchaseAgreements
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">agreementNumber</th>
			<th style="text-align:center">effectiveDate</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @purchaseAgreements.each do |purchaseAgreement| %>
		<tr>   
			<td style="text-align:center">
	  			<%= purchaseAgreement.agreementNumber %>
			</td>
			<td style="text-align:center">
	  			<%= purchaseAgreement.effectiveDate %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_purchaseAgreement_path(purchaseAgreement), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', purchaseAgreement_path(purchaseAgreement), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PurchaseAgreement', new_purchaseAgreement_path, :method => :get, :class => "btn btn-success btn-sm" %>