<div class="title text-center">
  List of Registrations
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">tailNumber</th>
			<th style="text-align:center">registryCountry</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @registrations.each do |registration| %>
		<tr>   
			<td style="text-align:center">
	  			<%= registration.tailNumber %>
			</td>
			<td style="text-align:center">
	  			<%= registration.registryCountry %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_registration_path(registration), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', registration_path(registration), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Registration', new_registration_path, :method => :get, :class => "btn btn-success btn-sm" %>