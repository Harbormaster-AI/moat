<div class="title text-center">
  List of AnalyticsWorkspaces
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">businessDomain</th>
			<th style="text-align:center">ownerTeam</th>
			<th style="text-align:center">GovernanceTier</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @analyticsWorkspaces.each do |analyticsWorkspace| %>
		<tr>   
			<td style="text-align:center">
	  			<%= analyticsWorkspace.name %>
			</td>
			<td style="text-align:center">
	  			<%= analyticsWorkspace.businessDomain %>
			</td>
			<td style="text-align:center">
	  			<%= analyticsWorkspace.ownerTeam %>
			</td>
			<td style="text-align:center">
	  			<%= analyticsWorkspace.GovernanceTier %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_analyticsWorkspace_path(analyticsWorkspace), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', analyticsWorkspace_path(analyticsWorkspace), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AnalyticsWorkspace', new_analyticsWorkspace_path, :method => :get, :class => "btn btn-success btn-sm" %>