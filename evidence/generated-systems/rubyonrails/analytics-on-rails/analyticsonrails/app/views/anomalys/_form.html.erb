<%= form_with model: @anomaly, local: true do |form| %>
 
  <% if @anomaly.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@anomaly.errors.count, "error") %> prohibited
        this anomaly from being saved:
