	<%= form.text_field :details, { class: 'form-label'} %>
  </p>			
  <p>
  </p>			
  <p>
  </p>			
  <p>
  </p>			
  <p>
   <%= form.label :AnomalyType, { class: 'form-label'} %><br>
   <%= form.select :AnomalyType, Anomaly.AnomalyTypes.keys, { class: 'form-control'} %>
  </p>			
  <p>
   <%= form.label :Severity, { class: 'form-label'} %><br>
   <%= form.select :Severity, Anomaly.Severitys.keys, { class: 'form-control'} %>
  </p>			

      <%= form.submit %>
    
