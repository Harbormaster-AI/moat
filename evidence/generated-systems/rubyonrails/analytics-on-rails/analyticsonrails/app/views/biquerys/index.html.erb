<div class="title text-center">
  List of BIQuerys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">text</th>
			<th style="text-align:center">Dialect</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @bIQuerys.each do |bIQuery| %>
		<tr>   
			<td style="text-align:center">
	  			<%= bIQuery.name %>
			</td>
			<td style="text-align:center">
	  			<%= bIQuery.text %>
			</td>
			<td style="text-align:center">
	  			<%= bIQuery.Dialect %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_bIQuery_path(bIQuery), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', bIQuery_path(bIQuery), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New BIQuery', new_bIQuery_path, :method => :get, :class => "btn btn-success btn-sm" %>