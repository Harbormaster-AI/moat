<div class="title text-center">
  List of Dashboards
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">title</th>
			<th style="text-align:center">theme</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dashboards.each do |dashboard| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dashboard.title %>
			</td>
			<td style="text-align:center">
	  			<%= dashboard.theme %>
			</td>
			<td style="text-align:center">
	  			<%= dashboard.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dashboard_path(dashboard), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dashboard_path(dashboard), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Dashboard', new_dashboard_path, :method => :get, :class => "btn btn-success btn-sm" %>