<div class="title text-center">
  List of DataPipelines
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">schedule</th>
			<th style="text-align:center">TriggerType</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dataPipelines.each do |dataPipeline| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dataPipeline.name %>
			</td>
			<td style="text-align:center">
	  			<%= dataPipeline.schedule %>
			</td>
			<td style="text-align:center">
	  			<%= dataPipeline.TriggerType %>
			</td>
			<td style="text-align:center">
	  			<%= dataPipeline.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dataPipeline_path(dataPipeline), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dataPipeline_path(dataPipeline), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DataPipeline', new_dataPipeline_path, :method => :get, :class => "btn btn-success btn-sm" %>