<div class="title text-center">
  List of DataSets
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">schemaVersion</th>
			<th style="text-align:center">refreshSchedule</th>
			<th style="text-align:center">Sensitive</th>
			<th style="text-align:center">DataFormat</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dataSets.each do |dataSet| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dataSet.name %>
			</td>
			<td style="text-align:center">
	  			<%= dataSet.schemaVersion %>
			</td>
			<td style="text-align:center">
	  			<%= dataSet.refreshSchedule %>
			</td>
			<td style="text-align:center">
	  			<%= dataSet.Sensitive %>
			</td>
			<td style="text-align:center">
	  			<%= dataSet.DataFormat %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dataSet_path(dataSet), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dataSet_path(dataSet), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DataSet', new_dataSet_path, :method => :get, :class => "btn btn-success btn-sm" %>