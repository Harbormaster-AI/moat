<div class="title text-center">
  List of DataSources
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">connection</th>
			<th style="text-align:center">Streaming</th>
			<th style="text-align:center">SourceType</th>
			<th style="text-align:center">Format</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dataSources.each do |dataSource| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dataSource.name %>
			</td>
			<td style="text-align:center">
	  			<%= dataSource.connection %>
			</td>
			<td style="text-align:center">
	  			<%= dataSource.Streaming %>
			</td>
			<td style="text-align:center">
	  			<%= dataSource.SourceType %>
			</td>
			<td style="text-align:center">
	  			<%= dataSource.Format %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dataSource_path(dataSource), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dataSource_path(dataSource), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DataSource', new_dataSource_path, :method => :get, :class => "btn btn-success btn-sm" %>