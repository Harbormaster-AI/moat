<div class="title text-center">
  List of DataTasks
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">command</th>
			<th style="text-align:center">retries</th>
			<th style="text-align:center">TaskType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dataTasks.each do |dataTask| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dataTask.name %>
			</td>
			<td style="text-align:center">
	  			<%= dataTask.command %>
			</td>
			<td style="text-align:center">
	  			<%= dataTask.retries %>
			</td>
			<td style="text-align:center">
	  			<%= dataTask.TaskType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dataTask_path(dataTask), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dataTask_path(dataTask), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DataTask', new_dataTask_path, :method => :get, :class => "btn btn-success btn-sm" %>