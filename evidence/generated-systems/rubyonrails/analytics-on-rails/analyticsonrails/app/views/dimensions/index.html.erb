<div class="title text-center">
  List of Dimensions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">typeTime</th>
			<th style="text-align:center">DimensionType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dimensions.each do |dimension| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dimension.name %>
			</td>
			<td style="text-align:center">
	  			<%= dimension.typeTime %>
			</td>
			<td style="text-align:center">
	  			<%= dimension.DimensionType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dimension_path(dimension), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dimension_path(dimension), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Dimension', new_dimension_path, :method => :get, :class => "btn btn-success btn-sm" %>