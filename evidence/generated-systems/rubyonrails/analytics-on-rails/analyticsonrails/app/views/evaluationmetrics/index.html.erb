<div class="title text-center">
  List of EvaluationMetrics
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">value</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @evaluationMetrics.each do |evaluationMetric| %>
		<tr>   
			<td style="text-align:center">
	  			<%= evaluationMetric.name %>
			</td>
			<td style="text-align:center">
	  			<%= evaluationMetric.value %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_evaluationMetric_path(evaluationMetric), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', evaluationMetric_path(evaluationMetric), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New EvaluationMetric', new_evaluationMetric_path, :method => :get, :class => "btn btn-success btn-sm" %>