<div class="title text-center">
  List of Features
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">description</th>
			<th style="text-align:center">DataType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @features.each do |feature| %>
		<tr>   
			<td style="text-align:center">
	  			<%= feature.name %>
			</td>
			<td style="text-align:center">
	  			<%= feature.description %>
			</td>
			<td style="text-align:center">
	  			<%= feature.DataType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_feature_path(feature), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', feature_path(feature), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Feature', new_feature_path, :method => :get, :class => "btn btn-success btn-sm" %>