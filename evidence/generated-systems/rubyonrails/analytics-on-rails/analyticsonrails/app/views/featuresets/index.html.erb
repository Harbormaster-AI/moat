<div class="title text-center">
  List of FeatureSets
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">refreshSchedule</th>
			<th style="text-align:center">StoreType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @featureSets.each do |featureSet| %>
		<tr>   
			<td style="text-align:center">
	  			<%= featureSet.name %>
			</td>
			<td style="text-align:center">
	  			<%= featureSet.refreshSchedule %>
			</td>
			<td style="text-align:center">
	  			<%= featureSet.StoreType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_featureSet_path(featureSet), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', featureSet_path(featureSet), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New FeatureSet', new_featureSet_path, :method => :get, :class => "btn btn-success btn-sm" %>