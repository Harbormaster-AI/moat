<div class="title text-center">
  List of Forecasts
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">horizon</th>
			<th style="text-align:center">Granularity</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @forecasts.each do |forecast| %>
		<tr>   
			<td style="text-align:center">
	  			<%= forecast.name %>
			</td>
			<td style="text-align:center">
	  			<%= forecast.horizon %>
			</td>
			<td style="text-align:center">
	  			<%= forecast.Granularity %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_forecast_path(forecast), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', forecast_path(forecast), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Forecast', new_forecast_path, :method => :get, :class => "btn btn-success btn-sm" %>