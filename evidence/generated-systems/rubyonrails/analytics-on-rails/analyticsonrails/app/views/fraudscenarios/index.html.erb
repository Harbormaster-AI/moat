<div class="title text-center">
  List of FraudScenarios
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">riskAppetite</th>
			<th style="text-align:center">DetectionType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @fraudScenarios.each do |fraudScenario| %>
		<tr>   
			<td style="text-align:center">
	  			<%= fraudScenario.name %>
			</td>
			<td style="text-align:center">
	  			<%= fraudScenario.riskAppetite %>
			</td>
			<td style="text-align:center">
	  			<%= fraudScenario.DetectionType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_fraudScenario_path(fraudScenario), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', fraudScenario_path(fraudScenario), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New FraudScenario', new_fraudScenario_path, :method => :get, :class => "btn btn-success btn-sm" %>