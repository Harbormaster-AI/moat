<div class="title text-center">
  List of InferenceEndpoints
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">endpointUrl</th>
			<th style="text-align:center">trafficShare</th>
			<th style="text-align:center">Mode</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @inferenceEndpoints.each do |inferenceEndpoint| %>
		<tr>   
			<td style="text-align:center">
	  			<%= inferenceEndpoint.name %>
			</td>
			<td style="text-align:center">
	  			<%= inferenceEndpoint.endpointUrl %>
			</td>
			<td style="text-align:center">
	  			<%= inferenceEndpoint.trafficShare %>
			</td>
			<td style="text-align:center">
	  			<%= inferenceEndpoint.Mode %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_inferenceEndpoint_path(inferenceEndpoint), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', inferenceEndpoint_path(inferenceEndpoint), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InferenceEndpoint', new_inferenceEndpoint_path, :method => :get, :class => "btn btn-success btn-sm" %>