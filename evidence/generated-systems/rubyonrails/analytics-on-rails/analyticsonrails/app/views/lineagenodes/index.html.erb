<div class="title text-center">
  List of LineageNodes
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">qualifiedName</th>
			<th style="text-align:center">NodeType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @lineageNodes.each do |lineageNode| %>
		<tr>   
			<td style="text-align:center">
	  			<%= lineageNode.name %>
			</td>
			<td style="text-align:center">
	  			<%= lineageNode.qualifiedName %>
			</td>
			<td style="text-align:center">
	  			<%= lineageNode.NodeType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_lineageNode_path(lineageNode), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', lineageNode_path(lineageNode), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New LineageNode', new_lineageNode_path, :method => :get, :class => "btn btn-success btn-sm" %>