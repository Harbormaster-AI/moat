<div class="title text-center">
  List of Metrics
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">expression</th>
			<th style="text-align:center">unit</th>
			<th style="text-align:center">MetricType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @metrics.each do |metric| %>
		<tr>   
			<td style="text-align:center">
	  			<%= metric.name %>
			</td>
			<td style="text-align:center">
	  			<%= metric.expression %>
			</td>
			<td style="text-align:center">
	  			<%= metric.unit %>
			</td>
			<td style="text-align:center">
	  			<%= metric.MetricType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_metric_path(metric), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', metric_path(metric), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Metric', new_metric_path, :method => :get, :class => "btn btn-success btn-sm" %>