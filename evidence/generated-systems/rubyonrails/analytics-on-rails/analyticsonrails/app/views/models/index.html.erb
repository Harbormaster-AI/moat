<div class="title text-center">
  List of Models
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">taskDescription</th>
			<th style="text-align:center">ModelType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @models.each do |model| %>
		<tr>   
			<td style="text-align:center">
	  			<%= model.name %>
			</td>
			<td style="text-align:center">
	  			<%= model.taskDescription %>
			</td>
			<td style="text-align:center">
	  			<%= model.ModelType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_model_path(model), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', model_path(model), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Model', new_model_path, :method => :get, :class => "btn btn-success btn-sm" %>