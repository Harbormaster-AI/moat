<div class="title text-center">
  List of QualityChecks
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">checkedAt</th>
			<th style="text-align:center">observedValue</th>
			<th style="text-align:center">sampleSize</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @qualityChecks.each do |qualityCheck| %>
		<tr>   
			<td style="text-align:center">
	  			<%= qualityCheck.checkedAt %>
			</td>
			<td style="text-align:center">
	  			<%= qualityCheck.observedValue %>
			</td>
			<td style="text-align:center">
	  			<%= qualityCheck.sampleSize %>
			</td>
			<td style="text-align:center">
	  			<%= qualityCheck.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_qualityCheck_path(qualityCheck), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', qualityCheck_path(qualityCheck), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New QualityCheck', new_qualityCheck_path, :method => :get, :class => "btn btn-success btn-sm" %>