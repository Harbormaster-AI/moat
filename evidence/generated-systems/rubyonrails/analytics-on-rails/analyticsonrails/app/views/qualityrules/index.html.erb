<div class="title text-center">
  List of QualityRules
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">threshold</th>
			<th style="text-align:center">targetField</th>
			<th style="text-align:center">Dimension</th>
			<th style="text-align:center">Operator</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @qualityRules.each do |qualityRule| %>
		<tr>   
			<td style="text-align:center">
	  			<%= qualityRule.name %>
			</td>
			<td style="text-align:center">
	  			<%= qualityRule.threshold %>
			</td>
			<td style="text-align:center">
	  			<%= qualityRule.targetField %>
			</td>
			<td style="text-align:center">
	  			<%= qualityRule.Dimension %>
			</td>
			<td style="text-align:center">
	  			<%= qualityRule.Operator %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_qualityRule_path(qualityRule), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', qualityRule_path(qualityRule), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New QualityRule', new_qualityRule_path, :method => :get, :class => "btn btn-success btn-sm" %>