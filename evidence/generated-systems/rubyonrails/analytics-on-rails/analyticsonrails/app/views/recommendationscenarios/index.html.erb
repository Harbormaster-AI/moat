<div class="title text-center">
  List of RecommendationScenarios
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">objective</th>
			<th style="text-align:center">RecommendationType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @recommendationScenarios.each do |recommendationScenario| %>
		<tr>   
			<td style="text-align:center">
	  			<%= recommendationScenario.name %>
			</td>
			<td style="text-align:center">
	  			<%= recommendationScenario.objective %>
			</td>
			<td style="text-align:center">
	  			<%= recommendationScenario.RecommendationType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_recommendationScenario_path(recommendationScenario), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', recommendationScenario_path(recommendationScenario), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New RecommendationScenario', new_recommendationScenario_path, :method => :get, :class => "btn btn-success btn-sm" %>