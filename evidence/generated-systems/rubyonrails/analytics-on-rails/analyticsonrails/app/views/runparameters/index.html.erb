<div class="title text-center">
  List of RunParameters
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">value</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @runParameters.each do |runParameter| %>
		<tr>   
			<td style="text-align:center">
	  			<%= runParameter.name %>
			</td>
			<td style="text-align:center">
	  			<%= runParameter.value %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_runParameter_path(runParameter), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', runParameter_path(runParameter), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New RunParameter', new_runParameter_path, :method => :get, :class => "btn btn-success btn-sm" %>