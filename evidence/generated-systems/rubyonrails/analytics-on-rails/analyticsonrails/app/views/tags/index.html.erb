<div class="title text-center">
  List of Tags
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">Category</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @tags.each do |tag| %>
		<tr>   
			<td style="text-align:center">
	  			<%= tag.name %>
			</td>
			<td style="text-align:center">
	  			<%= tag.Category %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_tag_path(tag), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', tag_path(tag), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Tag', new_tag_path, :method => :get, :class => "btn btn-success btn-sm" %>