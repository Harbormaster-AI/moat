<div class="title text-center">
  List of TimeSeriess
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">timezone</th>
			<th style="text-align:center">Granularity</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @timeSeriess.each do |timeSeries| %>
		<tr>   
			<td style="text-align:center">
	  			<%= timeSeries.name %>
			</td>
			<td style="text-align:center">
	  			<%= timeSeries.timezone %>
			</td>
			<td style="text-align:center">
	  			<%= timeSeries.Granularity %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_timeSeries_path(timeSeries), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', timeSeries_path(timeSeries), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TimeSeries', new_timeSeries_path, :method => :get, :class => "btn btn-success btn-sm" %>