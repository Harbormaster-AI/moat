	<%= form.text_field :openingBalance, { class: 'form-label'} %>
  </p>			
  <p>
    <%= form.label :closingBalance, { class: 'form-label'} %><br>
	<%= form.text_field :closingBalance, { class: 'form-label'} %>
  </p>			
  <p>
  </p>			
  <p>
   <%= form.label :DeliveryMethod, { class: 'form-label'} %><br>
