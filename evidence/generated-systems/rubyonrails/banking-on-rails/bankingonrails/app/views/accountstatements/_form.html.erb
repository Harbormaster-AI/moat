<%= form_with model: @accountStatement, local: true do |form| %>
 
  <% if @accountStatement.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@accountStatement.errors.count, "error") %> prohibited
        this accountStatement from being saved:
      </h2>
      <ul>
        <% @accountStatement.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="card">
    <div class="card-body">

