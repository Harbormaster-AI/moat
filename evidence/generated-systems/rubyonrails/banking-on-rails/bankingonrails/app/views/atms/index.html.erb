<div class="title text-center">
  List of ATMs
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">terminalId</th>
			<th style="text-align:center">location</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aTMs.each do |aTM| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aTM.terminalId %>
			</td>
			<td style="text-align:center">
	  			<%= aTM.location %>
			</td>
			<td style="text-align:center">
	  			<%= aTM.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aTM_path(aTM), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aTM_path(aTM), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ATM', new_aTM_path, :method => :get, :class => "btn btn-success btn-sm" %>