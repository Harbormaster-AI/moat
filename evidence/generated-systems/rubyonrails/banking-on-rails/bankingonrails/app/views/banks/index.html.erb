<div class="title text-center">
  List of Banks
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">legalName</th>
			<th style="text-align:center">swiftBic</th>
			<th style="text-align:center">headquartersCountry</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @banks.each do |bank| %>
		<tr>   
			<td style="text-align:center">
	  			<%= bank.name %>
			</td>
			<td style="text-align:center">
	  			<%= bank.legalName %>
			</td>
			<td style="text-align:center">
	  			<%= bank.swiftBic %>
			</td>
			<td style="text-align:center">
	  			<%= bank.headquartersCountry %>
			</td>
			<td style="text-align:center">
	  			<%= bank.website %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_bank_path(bank), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', bank_path(bank), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Bank', new_bank_path, :method => :get, :class => "btn btn-success btn-sm" %>