<div class="title text-center">
  List of Branchs
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">branchCode</th>
			<th style="text-align:center">address</th>
			<th style="text-align:center">phone</th>
			<th style="text-align:center">openingHours</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @branchs.each do |branch| %>
		<tr>   
			<td style="text-align:center">
	  			<%= branch.name %>
			</td>
			<td style="text-align:center">
	  			<%= branch.branchCode %>
			</td>
			<td style="text-align:center">
	  			<%= branch.address %>
			</td>
			<td style="text-align:center">
	  			<%= branch.phone %>
			</td>
			<td style="text-align:center">
	  			<%= branch.openingHours %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_branch_path(branch), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', branch_path(branch), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Branch', new_branch_path, :method => :get, :class => "btn btn-success btn-sm" %>