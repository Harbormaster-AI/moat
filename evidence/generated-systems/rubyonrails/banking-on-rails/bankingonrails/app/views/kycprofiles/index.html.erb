<div class="title text-center">
  List of KycProfiles
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">profileId</th>
			<th style="text-align:center">lastReviewedOn</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @kycProfiles.each do |kycProfile| %>
		<tr>   
			<td style="text-align:center">
	  			<%= kycProfile.profileId %>
			</td>
			<td style="text-align:center">
	  			<%= kycProfile.lastReviewedOn %>
			</td>
			<td style="text-align:center">
	  			<%= kycProfile.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_kycProfile_path(kycProfile), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', kycProfile_path(kycProfile), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New KycProfile', new_kycProfile_path, :method => :get, :class => "btn btn-success btn-sm" %>