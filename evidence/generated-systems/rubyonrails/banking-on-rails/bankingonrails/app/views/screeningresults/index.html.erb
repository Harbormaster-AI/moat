<div class="title text-center">
  List of ScreeningResults
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">screeningDate</th>
			<th style="text-align:center">provider</th>
			<th style="text-align:center">Outcome</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @screeningResults.each do |screeningResult| %>
		<tr>   
			<td style="text-align:center">
	  			<%= screeningResult.screeningDate %>
			</td>
			<td style="text-align:center">
	  			<%= screeningResult.provider %>
			</td>
			<td style="text-align:center">
	  			<%= screeningResult.Outcome %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_screeningResult_path(screeningResult), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', screeningResult_path(screeningResult), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ScreeningResult', new_screeningResult_path, :method => :get, :class => "btn btn-success btn-sm" %>