<div class="title text-center">
  List of ThirdPartyProviders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">registrationId</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @thirdPartyProviders.each do |thirdPartyProvider| %>
		<tr>   
			<td style="text-align:center">
	  			<%= thirdPartyProvider.name %>
			</td>
			<td style="text-align:center">
	  			<%= thirdPartyProvider.registrationId %>
			</td>
			<td style="text-align:center">
	  			<%= thirdPartyProvider.website %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_thirdPartyProvider_path(thirdPartyProvider), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', thirdPartyProvider_path(thirdPartyProvider), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ThirdPartyProvider', new_thirdPartyProvider_path, :method => :get, :class => "btn btn-success btn-sm" %>