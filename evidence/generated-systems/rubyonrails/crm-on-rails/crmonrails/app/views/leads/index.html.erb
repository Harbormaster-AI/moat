<div class="title text-center">
  List of Leads
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">firstName</th>
			<th style="text-align:center">lastName</th>
			<th style="text-align:center">company</th>
			<th style="text-align:center">email</th>
			<th style="text-align:center">phone</th>
			<th style="text-align:center">converted</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center">Source</th>
			<th style="text-align:center">Rating</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @leads.each do |lead| %>
		<tr>   
			<td style="text-align:center">
	  			<%= lead.firstName %>
			</td>
			<td style="text-align:center">
	  			<%= lead.lastName %>
			</td>
			<td style="text-align:center">
	  			<%= lead.company %>
			</td>
			<td style="text-align:center">
	  			<%= lead.email %>
			</td>
			<td style="text-align:center">
	  			<%= lead.phone %>
			</td>
			<td style="text-align:center">
	  			<%= lead.converted %>
			</td>
			<td style="text-align:center">
	  			<%= lead.Status %>
			</td>
			<td style="text-align:center">
	  			<%= lead.Source %>
			</td>
			<td style="text-align:center">
	  			<%= lead.Rating %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_lead_path(lead), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', lead_path(lead), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Lead', new_lead_path, :method => :get, :class => "btn btn-success btn-sm" %>