<div class="title text-center">
  List of OpportunityLineItems
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">unitPrice</th>
			<th style="text-align:center">discountPercent</th>
			<th style="text-align:center">totalPrice</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @opportunityLineItems.each do |opportunityLineItem| %>
		<tr>   
			<td style="text-align:center">
	  			<%= opportunityLineItem.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= opportunityLineItem.unitPrice %>
			</td>
			<td style="text-align:center">
	  			<%= opportunityLineItem.discountPercent %>
			</td>
			<td style="text-align:center">
	  			<%= opportunityLineItem.totalPrice %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_opportunityLineItem_path(opportunityLineItem), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', opportunityLineItem_path(opportunityLineItem), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New OpportunityLineItem', new_opportunityLineItem_path, :method => :get, :class => "btn btn-success btn-sm" %>