<div class="title text-center">
  List of Opportunitys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">amount</th>
			<th style="text-align:center">closeDate</th>
			<th style="text-align:center">probability</th>
			<th style="text-align:center">description</th>
			<th style="text-align:center">Stage</th>
			<th style="text-align:center">Type</th>
			<th style="text-align:center">ForecastCategory</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @opportunitys.each do |opportunity| %>
		<tr>   
			<td style="text-align:center">
	  			<%= opportunity.name %>
			</td>
			<td style="text-align:center">
	  			<%= opportunity.amount %>
			</td>
			<td style="text-align:center">
	  			<%= opportunity.closeDate %>
			</td>
			<td style="text-align:center">
	  			<%= opportunity.probability %>
			</td>
			<td style="text-align:center">
	  			<%= opportunity.description %>
			</td>
			<td style="text-align:center">
	  			<%= opportunity.Stage %>
			</td>
			<td style="text-align:center">
	  			<%= opportunity.Type %>
			</td>
			<td style="text-align:center">
	  			<%= opportunity.ForecastCategory %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_opportunity_path(opportunity), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', opportunity_path(opportunity), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Opportunity', new_opportunity_path, :method => :get, :class => "btn btn-success btn-sm" %>