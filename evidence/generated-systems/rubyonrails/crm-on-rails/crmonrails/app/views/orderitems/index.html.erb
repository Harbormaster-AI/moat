<div class="title text-center">
  List of OrderItems
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">unitPrice</th>
			<th style="text-align:center">discountAmount</th>
			<th style="text-align:center">taxAmount</th>
			<th style="text-align:center">totalAmount</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @orderItems.each do |orderItem| %>
		<tr>   
			<td style="text-align:center">
	  			<%= orderItem.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= orderItem.unitPrice %>
			</td>
			<td style="text-align:center">
	  			<%= orderItem.discountAmount %>
			</td>
			<td style="text-align:center">
	  			<%= orderItem.taxAmount %>
			</td>
			<td style="text-align:center">
	  			<%= orderItem.totalAmount %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_orderItem_path(orderItem), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', orderItem_path(orderItem), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New OrderItem', new_orderItem_path, :method => :get, :class => "btn btn-success btn-sm" %>