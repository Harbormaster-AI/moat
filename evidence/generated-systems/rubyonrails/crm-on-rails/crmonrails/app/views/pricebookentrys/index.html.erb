<div class="title text-center">
  List of PriceBookEntrys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">unitPrice</th>
			<th style="text-align:center">effectiveDate</th>
			<th style="text-align:center">expirationDate</th>
			<th style="text-align:center">asActive</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @priceBookEntrys.each do |priceBookEntry| %>
		<tr>   
			<td style="text-align:center">
	  			<%= priceBookEntry.unitPrice %>
			</td>
			<td style="text-align:center">
	  			<%= priceBookEntry.effectiveDate %>
			</td>
			<td style="text-align:center">
	  			<%= priceBookEntry.expirationDate %>
			</td>
			<td style="text-align:center">
	  			<%= priceBookEntry.asActive %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_priceBookEntry_path(priceBookEntry), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', priceBookEntry_path(priceBookEntry), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PriceBookEntry', new_priceBookEntry_path, :method => :get, :class => "btn btn-success btn-sm" %>