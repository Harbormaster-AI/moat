<div class="title text-center">
  List of PriceBooks
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">asActive</th>
			<th style="text-align:center">description</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @priceBooks.each do |priceBook| %>
		<tr>   
			<td style="text-align:center">
	  			<%= priceBook.name %>
			</td>
			<td style="text-align:center">
	  			<%= priceBook.asActive %>
			</td>
			<td style="text-align:center">
	  			<%= priceBook.description %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_priceBook_path(priceBook), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', priceBook_path(priceBook), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PriceBook', new_priceBook_path, :method => :get, :class => "btn btn-success btn-sm" %>