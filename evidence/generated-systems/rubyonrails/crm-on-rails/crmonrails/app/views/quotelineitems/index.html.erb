<div class="title text-center">
  List of QuoteLineItems
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">unitPrice</th>
			<th style="text-align:center">discountAmount</th>
			<th style="text-align:center">taxAmount</th>
			<th style="text-align:center">totalAmount</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @quoteLineItems.each do |quoteLineItem| %>
		<tr>   
			<td style="text-align:center">
	  			<%= quoteLineItem.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= quoteLineItem.unitPrice %>
			</td>
			<td style="text-align:center">
	  			<%= quoteLineItem.discountAmount %>
			</td>
			<td style="text-align:center">
	  			<%= quoteLineItem.taxAmount %>
			</td>
			<td style="text-align:center">
	  			<%= quoteLineItem.totalAmount %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_quoteLineItem_path(quoteLineItem), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', quoteLineItem_path(quoteLineItem), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New QuoteLineItem', new_quoteLineItem_path, :method => :get, :class => "btn btn-success btn-sm" %>