<div class="title text-center">
  List of Territorys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">region</th>
			<th style="text-align:center">TerritoryType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @territorys.each do |territory| %>
		<tr>   
			<td style="text-align:center">
	  			<%= territory.name %>
			</td>
			<td style="text-align:center">
	  			<%= territory.region %>
			</td>
			<td style="text-align:center">
	  			<%= territory.TerritoryType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_territory_path(territory), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', territory_path(territory), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Territory', new_territory_path, :method => :get, :class => "btn btn-success btn-sm" %>