<div class="title text-center">
  List of Users
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">username</th>
			<th style="text-align:center">fullName</th>
			<th style="text-align:center">email</th>
			<th style="text-align:center">locale</th>
			<th style="text-align:center">Role</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @users.each do |user| %>
		<tr>   
			<td style="text-align:center">
	  			<%= user.username %>
			</td>
			<td style="text-align:center">
	  			<%= user.fullName %>
			</td>
			<td style="text-align:center">
	  			<%= user.email %>
			</td>
			<td style="text-align:center">
	  			<%= user.locale %>
			</td>
			<td style="text-align:center">
	  			<%= user.Role %>
			</td>
			<td style="text-align:center">
	  			<%= user.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_user_path(user), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', user_path(user), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New User', new_user_path, :method => :get, :class => "btn btn-success btn-sm" %>