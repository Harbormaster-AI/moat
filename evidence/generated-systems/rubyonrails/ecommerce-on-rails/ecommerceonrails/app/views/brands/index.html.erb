<div class="title text-center">
  List of Brands
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">description</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @brands.each do |brand| %>
		<tr>   
			<td style="text-align:center">
	  			<%= brand.name %>
			</td>
			<td style="text-align:center">
	  			<%= brand.description %>
			</td>
			<td style="text-align:center">
	  			<%= brand.website %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_brand_path(brand), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', brand_path(brand), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Brand', new_brand_path, :method => :get, :class => "btn btn-success btn-sm" %>