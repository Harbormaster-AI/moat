<div class="title text-center">
  List of CarrierServices
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">code</th>
			<th style="text-align:center">Carrier</th>
			<th style="text-align:center">ServiceLevel</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @carrierServices.each do |carrierService| %>
		<tr>   
			<td style="text-align:center">
	  			<%= carrierService.name %>
			</td>
			<td style="text-align:center">
	  			<%= carrierService.code %>
			</td>
			<td style="text-align:center">
	  			<%= carrierService.Carrier %>
			</td>
			<td style="text-align:center">
	  			<%= carrierService.ServiceLevel %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_carrierService_path(carrierService), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', carrierService_path(carrierService), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CarrierService', new_carrierService_path, :method => :get, :class => "btn btn-success btn-sm" %>