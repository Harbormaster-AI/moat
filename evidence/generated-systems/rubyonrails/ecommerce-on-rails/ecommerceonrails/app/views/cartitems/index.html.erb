<div class="title text-center">
  List of CartItems
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">unitPrice</th>
			<th style="text-align:center">totalPrice</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @cartItems.each do |cartItem| %>
		<tr>   
			<td style="text-align:center">
	  			<%= cartItem.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= cartItem.unitPrice %>
			</td>
			<td style="text-align:center">
	  			<%= cartItem.totalPrice %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_cartItem_path(cartItem), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', cartItem_path(cartItem), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CartItem', new_cartItem_path, :method => :get, :class => "btn btn-success btn-sm" %>