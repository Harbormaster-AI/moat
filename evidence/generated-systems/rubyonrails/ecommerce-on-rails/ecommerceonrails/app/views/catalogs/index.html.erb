<div class="title text-center">
  List of Catalogs
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">catalogCode</th>
			<th style="text-align:center">asActive</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @catalogs.each do |catalog| %>
		<tr>   
			<td style="text-align:center">
	  			<%= catalog.name %>
			</td>
			<td style="text-align:center">
	  			<%= catalog.catalogCode %>
			</td>
			<td style="text-align:center">
	  			<%= catalog.asActive %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_catalog_path(catalog), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', catalog_path(catalog), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Catalog', new_catalog_path, :method => :get, :class => "btn btn-success btn-sm" %>