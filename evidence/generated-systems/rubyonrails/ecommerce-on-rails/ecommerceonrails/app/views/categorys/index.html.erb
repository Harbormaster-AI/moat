<div class="title text-center">
  List of Categorys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">slug</th>
			<th style="text-align:center">position</th>
			<th style="text-align:center">asActive</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @categorys.each do |category| %>
		<tr>   
			<td style="text-align:center">
	  			<%= category.name %>
			</td>
			<td style="text-align:center">
	  			<%= category.slug %>
			</td>
			<td style="text-align:center">
	  			<%= category.position %>
			</td>
			<td style="text-align:center">
	  			<%= category.asActive %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_category_path(category), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', category_path(category), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Category', new_category_path, :method => :get, :class => "btn btn-success btn-sm" %>