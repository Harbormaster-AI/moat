<div class="title text-center">
  List of Channels
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">channelCode</th>
			<th style="text-align:center">locale</th>
			<th style="text-align:center">domain</th>
			<th style="text-align:center">asActive</th>
			<th style="text-align:center">defaultCurrency</th>
			<th style="text-align:center">ChannelType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @channels.each do |channel| %>
		<tr>   
			<td style="text-align:center">
	  			<%= channel.name %>
			</td>
			<td style="text-align:center">
	  			<%= channel.channelCode %>
			</td>
			<td style="text-align:center">
	  			<%= channel.locale %>
			</td>
			<td style="text-align:center">
	  			<%= channel.domain %>
			</td>
			<td style="text-align:center">
	  			<%= channel.asActive %>
			</td>
			<td style="text-align:center">
	  			<%= channel.defaultCurrency %>
			</td>
			<td style="text-align:center">
	  			<%= channel.ChannelType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_channel_path(channel), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', channel_path(channel), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Channel', new_channel_path, :method => :get, :class => "btn btn-success btn-sm" %>