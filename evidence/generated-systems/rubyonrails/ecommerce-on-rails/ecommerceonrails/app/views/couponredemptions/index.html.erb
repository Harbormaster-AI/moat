<div class="title text-center">
  List of CouponRedemptions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">redeemedAt</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @couponRedemptions.each do |couponRedemption| %>
		<tr>   
			<td style="text-align:center">
	  			<%= couponRedemption.redeemedAt %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_couponRedemption_path(couponRedemption), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', couponRedemption_path(couponRedemption), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CouponRedemption', new_couponRedemption_path, :method => :get, :class => "btn btn-success btn-sm" %>