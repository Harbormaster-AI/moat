<div class="title text-center">
  List of FulfillmentCenters
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">centerCode</th>
			<th style="text-align:center">address</th>
			<th style="text-align:center">timezone</th>
			<th style="text-align:center">asActive</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @fulfillmentCenters.each do |fulfillmentCenter| %>
		<tr>   
			<td style="text-align:center">
	  			<%= fulfillmentCenter.name %>
			</td>
			<td style="text-align:center">
	  			<%= fulfillmentCenter.centerCode %>
			</td>
			<td style="text-align:center">
	  			<%= fulfillmentCenter.address %>
			</td>
			<td style="text-align:center">
	  			<%= fulfillmentCenter.timezone %>
			</td>
			<td style="text-align:center">
	  			<%= fulfillmentCenter.asActive %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_fulfillmentCenter_path(fulfillmentCenter), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', fulfillmentCenter_path(fulfillmentCenter), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New FulfillmentCenter', new_fulfillmentCenter_path, :method => :get, :class => "btn btn-success btn-sm" %>