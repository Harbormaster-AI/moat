<div class="title text-center">
  List of GiftCardRedemptions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">redeemedAt</th>
			<th style="text-align:center">amount</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @giftCardRedemptions.each do |giftCardRedemption| %>
		<tr>   
			<td style="text-align:center">
	  			<%= giftCardRedemption.redeemedAt %>
			</td>
			<td style="text-align:center">
	  			<%= giftCardRedemption.amount %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_giftCardRedemption_path(giftCardRedemption), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', giftCardRedemption_path(giftCardRedemption), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New GiftCardRedemption', new_giftCardRedemption_path, :method => :get, :class => "btn btn-success btn-sm" %>