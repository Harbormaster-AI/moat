<div class="title text-center">
  List of GiftCards
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">code</th>
			<th style="text-align:center">balance</th>
			<th style="text-align:center">expirationDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @giftCards.each do |giftCard| %>
		<tr>   
			<td style="text-align:center">
	  			<%= giftCard.code %>
			</td>
			<td style="text-align:center">
	  			<%= giftCard.balance %>
			</td>
			<td style="text-align:center">
	  			<%= giftCard.expirationDate %>
			</td>
			<td style="text-align:center">
	  			<%= giftCard.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_giftCard_path(giftCard), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', giftCard_path(giftCard), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New GiftCard', new_giftCard_path, :method => :get, :class => "btn btn-success btn-sm" %>