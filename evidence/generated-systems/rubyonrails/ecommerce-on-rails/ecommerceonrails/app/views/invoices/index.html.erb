<div class="title text-center">
  List of Invoices
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">invoiceNumber</th>
			<th style="text-align:center">issuedDate</th>
			<th style="text-align:center">dueDate</th>
			<th style="text-align:center">total</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @invoices.each do |invoice| %>
		<tr>   
			<td style="text-align:center">
	  			<%= invoice.invoiceNumber %>
			</td>
			<td style="text-align:center">
	  			<%= invoice.issuedDate %>
			</td>
			<td style="text-align:center">
	  			<%= invoice.dueDate %>
			</td>
			<td style="text-align:center">
	  			<%= invoice.total %>
			</td>
			<td style="text-align:center">
	  			<%= invoice.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_invoice_path(invoice), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', invoice_path(invoice), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Invoice', new_invoice_path, :method => :get, :class => "btn btn-success btn-sm" %>