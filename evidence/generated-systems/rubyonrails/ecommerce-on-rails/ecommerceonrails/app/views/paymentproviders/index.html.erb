<div class="title text-center">
  List of PaymentProviders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">enabled</th>
			<th style="text-align:center">merchantAccountId</th>
			<th style="text-align:center">ProviderType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @paymentProviders.each do |paymentProvider| %>
		<tr>   
			<td style="text-align:center">
	  			<%= paymentProvider.name %>
			</td>
			<td style="text-align:center">
	  			<%= paymentProvider.enabled %>
			</td>
			<td style="text-align:center">
	  			<%= paymentProvider.merchantAccountId %>
			</td>
			<td style="text-align:center">
	  			<%= paymentProvider.ProviderType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_paymentProvider_path(paymentProvider), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', paymentProvider_path(paymentProvider), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PaymentProvider', new_paymentProvider_path, :method => :get, :class => "btn btn-success btn-sm" %>