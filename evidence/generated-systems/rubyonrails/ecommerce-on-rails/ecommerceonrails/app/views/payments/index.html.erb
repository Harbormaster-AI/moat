<div class="title text-center">
  List of Payments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">paymentNumber</th>
			<th style="text-align:center">amount</th>
			<th style="text-align:center">transactionId</th>
			<th style="text-align:center">authorizedAt</th>
			<th style="text-align:center">capturedAt</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center">PaymentMethod</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @payments.each do |payment| %>
		<tr>   
			<td style="text-align:center">
	  			<%= payment.paymentNumber %>
			</td>
			<td style="text-align:center">
	  			<%= payment.amount %>
			</td>
			<td style="text-align:center">
	  			<%= payment.transactionId %>
			</td>
			<td style="text-align:center">
	  			<%= payment.authorizedAt %>
			</td>
			<td style="text-align:center">
	  			<%= payment.capturedAt %>
			</td>
			<td style="text-align:center">
	  			<%= payment.Status %>
			</td>
			<td style="text-align:center">
	  			<%= payment.PaymentMethod %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_payment_path(payment), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', payment_path(payment), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Payment', new_payment_path, :method => :get, :class => "btn btn-success btn-sm" %>