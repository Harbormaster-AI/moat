<div class="title text-center">
  List of Products
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">slug</th>
			<th style="text-align:center">asActive</th>
			<th style="text-align:center">ProductType</th>
			<th style="text-align:center">DefaultTaxClass</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @products.each do |product| %>
		<tr>   
			<td style="text-align:center">
	  			<%= product.name %>
			</td>
			<td style="text-align:center">
	  			<%= product.slug %>
			</td>
			<td style="text-align:center">
	  			<%= product.asActive %>
			</td>
			<td style="text-align:center">
	  			<%= product.ProductType %>
			</td>
			<td style="text-align:center">
	  			<%= product.DefaultTaxClass %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_product_path(product), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', product_path(product), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Product', new_product_path, :method => :get, :class => "btn btn-success btn-sm" %>