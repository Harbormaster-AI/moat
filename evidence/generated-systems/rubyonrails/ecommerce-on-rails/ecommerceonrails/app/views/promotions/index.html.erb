<div class="title text-center">
  List of Promotions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">code</th>
			<th style="text-align:center">value</th>
			<th style="text-align:center">startDate</th>
			<th style="text-align:center">endDate</th>
			<th style="text-align:center">asStackable</th>
			<th style="text-align:center">maxRedemptions</th>
			<th style="text-align:center">PromotionType</th>
			<th style="text-align:center">DiscountType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @promotions.each do |promotion| %>
		<tr>   
			<td style="text-align:center">
	  			<%= promotion.name %>
			</td>
			<td style="text-align:center">
	  			<%= promotion.code %>
			</td>
			<td style="text-align:center">
	  			<%= promotion.value %>
			</td>
			<td style="text-align:center">
	  			<%= promotion.startDate %>
			</td>
			<td style="text-align:center">
	  			<%= promotion.endDate %>
			</td>
			<td style="text-align:center">
	  			<%= promotion.asStackable %>
			</td>
			<td style="text-align:center">
	  			<%= promotion.maxRedemptions %>
			</td>
			<td style="text-align:center">
	  			<%= promotion.PromotionType %>
			</td>
			<td style="text-align:center">
	  			<%= promotion.DiscountType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_promotion_path(promotion), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', promotion_path(promotion), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Promotion', new_promotion_path, :method => :get, :class => "btn btn-success btn-sm" %>