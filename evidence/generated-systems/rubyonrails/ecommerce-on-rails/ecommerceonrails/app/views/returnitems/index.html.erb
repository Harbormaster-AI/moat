<div class="title text-center">
  List of ReturnItems
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">Reason</th>
			<th style="text-align:center">Condition</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @returnItems.each do |returnItem| %>
		<tr>   
			<td style="text-align:center">
	  			<%= returnItem.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= returnItem.Reason %>
			</td>
			<td style="text-align:center">
	  			<%= returnItem.Condition %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_returnItem_path(returnItem), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', returnItem_path(returnItem), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ReturnItem', new_returnItem_path, :method => :get, :class => "btn btn-success btn-sm" %>