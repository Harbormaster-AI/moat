<div class="title text-center">
  List of Reviews
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">rating</th>
			<th style="text-align:center">title</th>
			<th style="text-align:center">content</th>
			<th style="text-align:center">createdAt</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @reviews.each do |review| %>
		<tr>   
			<td style="text-align:center">
	  			<%= review.rating %>
			</td>
			<td style="text-align:center">
	  			<%= review.title %>
			</td>
			<td style="text-align:center">
	  			<%= review.content %>
			</td>
			<td style="text-align:center">
	  			<%= review.createdAt %>
			</td>
			<td style="text-align:center">
	  			<%= review.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_review_path(review), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', review_path(review), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Review', new_review_path, :method => :get, :class => "btn btn-success btn-sm" %>