<div class="title text-center">
  List of Sellers
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">sellerCode</th>
			<th style="text-align:center">contactEmail</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @sellers.each do |seller| %>
		<tr>   
			<td style="text-align:center">
	  			<%= seller.name %>
			</td>
			<td style="text-align:center">
	  			<%= seller.sellerCode %>
			</td>
			<td style="text-align:center">
	  			<%= seller.contactEmail %>
			</td>
			<td style="text-align:center">
	  			<%= seller.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_seller_path(seller), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', seller_path(seller), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Seller', new_seller_path, :method => :get, :class => "btn btn-success btn-sm" %>