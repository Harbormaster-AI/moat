<div class="title text-center">
  List of ShippingMethods
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">flatRate</th>
			<th style="text-align:center">estimatedDays</th>
			<th style="text-align:center">asActive</th>
			<th style="text-align:center">MethodType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @shippingMethods.each do |shippingMethod| %>
		<tr>   
			<td style="text-align:center">
	  			<%= shippingMethod.name %>
			</td>
			<td style="text-align:center">
	  			<%= shippingMethod.flatRate %>
			</td>
			<td style="text-align:center">
	  			<%= shippingMethod.estimatedDays %>
			</td>
			<td style="text-align:center">
	  			<%= shippingMethod.asActive %>
			</td>
			<td style="text-align:center">
	  			<%= shippingMethod.MethodType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_shippingMethod_path(shippingMethod), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', shippingMethod_path(shippingMethod), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ShippingMethod', new_shippingMethod_path, :method => :get, :class => "btn btn-success btn-sm" %>