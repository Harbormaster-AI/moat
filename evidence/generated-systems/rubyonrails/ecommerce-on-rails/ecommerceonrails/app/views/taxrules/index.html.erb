<div class="title text-center">
  List of TaxRules
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">country</th>
			<th style="text-align:center">region</th>
			<th style="text-align:center">rate</th>
			<th style="text-align:center">taxInclusive</th>
			<th style="text-align:center">TaxClass</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @taxRules.each do |taxRule| %>
		<tr>   
			<td style="text-align:center">
	  			<%= taxRule.name %>
			</td>
			<td style="text-align:center">
	  			<%= taxRule.country %>
			</td>
			<td style="text-align:center">
	  			<%= taxRule.region %>
			</td>
			<td style="text-align:center">
	  			<%= taxRule.rate %>
			</td>
			<td style="text-align:center">
	  			<%= taxRule.taxInclusive %>
			</td>
			<td style="text-align:center">
	  			<%= taxRule.TaxClass %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_taxRule_path(taxRule), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', taxRule_path(taxRule), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TaxRule', new_taxRule_path, :method => :get, :class => "btn btn-success btn-sm" %>