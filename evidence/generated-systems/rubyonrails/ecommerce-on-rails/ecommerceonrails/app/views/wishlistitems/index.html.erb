<div class="title text-center">
  List of WishlistItems
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">addedDate</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @wishlistItems.each do |wishlistItem| %>
		<tr>   
			<td style="text-align:center">
	  			<%= wishlistItem.addedDate %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_wishlistItem_path(wishlistItem), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', wishlistItem_path(wishlistItem), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New WishlistItem', new_wishlistItem_path, :method => :get, :class => "btn btn-success btn-sm" %>