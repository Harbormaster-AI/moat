<div class="title text-center">
  List of Wishlists
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">asPublic</th>
			<th style="text-align:center">createdAt</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @wishlists.each do |wishlist| %>
		<tr>   
			<td style="text-align:center">
	  			<%= wishlist.name %>
			</td>
			<td style="text-align:center">
	  			<%= wishlist.asPublic %>
			</td>
			<td style="text-align:center">
	  			<%= wishlist.createdAt %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_wishlist_path(wishlist), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', wishlist_path(wishlist), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Wishlist', new_wishlist_path, :method => :get, :class => "btn btn-success btn-sm" %>