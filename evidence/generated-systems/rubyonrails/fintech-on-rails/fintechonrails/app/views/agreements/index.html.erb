<div class="title text-center">
  List of Agreements
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">agreementNumber</th>
			<th style="text-align:center">effectiveDate</th>
			<th style="text-align:center">AgreementType</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @agreements.each do |agreement| %>
		<tr>   
			<td style="text-align:center">
	  			<%= agreement.agreementNumber %>
			</td>
			<td style="text-align:center">
	  			<%= agreement.effectiveDate %>
			</td>
			<td style="text-align:center">
	  			<%= agreement.AgreementType %>
			</td>
			<td style="text-align:center">
	  			<%= agreement.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_agreement_path(agreement), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', agreement_path(agreement), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Agreement', new_agreement_path, :method => :get, :class => "btn btn-success btn-sm" %>