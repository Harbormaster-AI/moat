<div class="title text-center">
  List of APIClients
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">clientId</th>
			<th style="text-align:center">redirectUri</th>
			<th style="text-align:center">ClientType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @aPIClients.each do |aPIClient| %>
		<tr>   
			<td style="text-align:center">
	  			<%= aPIClient.name %>
			</td>
			<td style="text-align:center">
	  			<%= aPIClient.clientId %>
			</td>
			<td style="text-align:center">
	  			<%= aPIClient.redirectUri %>
			</td>
			<td style="text-align:center">
	  			<%= aPIClient.ClientType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_aPIClient_path(aPIClient), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', aPIClient_path(aPIClient), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New APIClient', new_aPIClient_path, :method => :get, :class => "btn btn-success btn-sm" %>