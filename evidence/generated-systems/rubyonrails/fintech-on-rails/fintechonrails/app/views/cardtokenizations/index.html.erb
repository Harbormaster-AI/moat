<div class="title text-center">
  List of CardTokenizations
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">tokenReference</th>
			<th style="text-align:center">createdAt</th>
			<th style="text-align:center">WalletProvider</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @cardTokenizations.each do |cardTokenization| %>
		<tr>   
			<td style="text-align:center">
	  			<%= cardTokenization.tokenReference %>
			</td>
			<td style="text-align:center">
	  			<%= cardTokenization.createdAt %>
			</td>
			<td style="text-align:center">
	  			<%= cardTokenization.WalletProvider %>
			</td>
			<td style="text-align:center">
	  			<%= cardTokenization.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_cardTokenization_path(cardTokenization), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', cardTokenization_path(cardTokenization), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CardTokenization', new_cardTokenization_path, :method => :get, :class => "btn btn-success btn-sm" %>