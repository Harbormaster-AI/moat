<div class="title text-center">
  List of Chargebacks
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">chargebackReference</th>
			<th style="text-align:center">amount</th>
			<th style="text-align:center">postedAt</th>
			<th style="text-align:center">Stage</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @chargebacks.each do |chargeback| %>
		<tr>   
			<td style="text-align:center">
	  			<%= chargeback.chargebackReference %>
			</td>
			<td style="text-align:center">
	  			<%= chargeback.amount %>
			</td>
			<td style="text-align:center">
	  			<%= chargeback.postedAt %>
			</td>
			<td style="text-align:center">
	  			<%= chargeback.Stage %>
			</td>
			<td style="text-align:center">
	  			<%= chargeback.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_chargeback_path(chargeback), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', chargeback_path(chargeback), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Chargeback', new_chargeback_path, :method => :get, :class => "btn btn-success btn-sm" %>