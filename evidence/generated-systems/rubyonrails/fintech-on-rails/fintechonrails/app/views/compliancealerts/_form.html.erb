    <%= form.label :notes, { class: 'form-label'} %><br>
	<%= form.text_field :notes, { class: 'form-label'} %>
  </p>			
  <p>
  </p>			
  <p>
  </p>			
  <p>
   <%= form.label :Severity, { class: 'form-label'} %><br>
