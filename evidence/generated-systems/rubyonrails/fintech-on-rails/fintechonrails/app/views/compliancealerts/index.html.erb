<div class="title text-center">
  List of ComplianceAlerts
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">alertCode</th>
			<th style="text-align:center">raisedAt</th>
			<th style="text-align:center">notes</th>
			<th style="text-align:center">Severity</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @complianceAlerts.each do |complianceAlert| %>
		<tr>   
			<td style="text-align:center">
	  			<%= complianceAlert.alertCode %>
			</td>
			<td style="text-align:center">
	  			<%= complianceAlert.raisedAt %>
			</td>
			<td style="text-align:center">
	  			<%= complianceAlert.notes %>
			</td>
			<td style="text-align:center">
	  			<%= complianceAlert.Severity %>
			</td>
			<td style="text-align:center">
	  			<%= complianceAlert.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_complianceAlert_path(complianceAlert), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', complianceAlert_path(complianceAlert), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ComplianceAlert', new_complianceAlert_path, :method => :get, :class => "btn btn-success btn-sm" %>