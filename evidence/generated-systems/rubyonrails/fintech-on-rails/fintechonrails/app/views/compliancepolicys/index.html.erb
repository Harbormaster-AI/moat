<div class="title text-center">
  List of CompliancePolicys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">policyCode</th>
			<th style="text-align:center">description</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @compliancePolicys.each do |compliancePolicy| %>
		<tr>   
			<td style="text-align:center">
	  			<%= compliancePolicy.name %>
			</td>
			<td style="text-align:center">
	  			<%= compliancePolicy.policyCode %>
			</td>
			<td style="text-align:center">
	  			<%= compliancePolicy.description %>
			</td>
			<td style="text-align:center">
	  			<%= compliancePolicy.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_compliancePolicy_path(compliancePolicy), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', compliancePolicy_path(compliancePolicy), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CompliancePolicy', new_compliancePolicy_path, :method => :get, :class => "btn btn-success btn-sm" %>