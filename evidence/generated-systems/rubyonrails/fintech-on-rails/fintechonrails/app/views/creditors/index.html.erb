<div class="title text-center">
  List of Creditors
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">bic</th>
			<th style="text-align:center">address</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @creditors.each do |creditor| %>
		<tr>   
			<td style="text-align:center">
	  			<%= creditor.name %>
			</td>
			<td style="text-align:center">
	  			<%= creditor.bic %>
			</td>
			<td style="text-align:center">
	  			<%= creditor.address %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_creditor_path(creditor), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', creditor_path(creditor), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Creditor', new_creditor_path, :method => :get, :class => "btn btn-success btn-sm" %>