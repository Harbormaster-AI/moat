<div class="title text-center">
  List of DirectDebitMandates
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">mandateId</th>
			<th style="text-align:center">signedAt</th>
			<th style="text-align:center">Scheme</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @directDebitMandates.each do |directDebitMandate| %>
		<tr>   
			<td style="text-align:center">
	  			<%= directDebitMandate.mandateId %>
			</td>
			<td style="text-align:center">
	  			<%= directDebitMandate.signedAt %>
			</td>
			<td style="text-align:center">
	  			<%= directDebitMandate.Scheme %>
			</td>
			<td style="text-align:center">
	  			<%= directDebitMandate.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_directDebitMandate_path(directDebitMandate), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', directDebitMandate_path(directDebitMandate), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DirectDebitMandate', new_directDebitMandate_path, :method => :get, :class => "btn btn-success btn-sm" %>