<div class="title text-center">
  List of FeeSchedules
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">amount</th>
			<th style="text-align:center">percentage</th>
			<th style="text-align:center">minimum</th>
			<th style="text-align:center">maximum</th>
			<th style="text-align:center">FeeType</th>
			<th style="text-align:center">CalculationMethod</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @feeSchedules.each do |feeSchedule| %>
		<tr>   
			<td style="text-align:center">
	  			<%= feeSchedule.name %>
			</td>
			<td style="text-align:center">
	  			<%= feeSchedule.amount %>
			</td>
			<td style="text-align:center">
	  			<%= feeSchedule.percentage %>
			</td>
			<td style="text-align:center">
	  			<%= feeSchedule.minimum %>
			</td>
			<td style="text-align:center">
	  			<%= feeSchedule.maximum %>
			</td>
			<td style="text-align:center">
	  			<%= feeSchedule.FeeType %>
			</td>
			<td style="text-align:center">
	  			<%= feeSchedule.CalculationMethod %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_feeSchedule_path(feeSchedule), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', feeSchedule_path(feeSchedule), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New FeeSchedule', new_feeSchedule_path, :method => :get, :class => "btn btn-success btn-sm" %>