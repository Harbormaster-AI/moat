<div class="title text-center">
  List of FinancialInstitutions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">legalName</th>
			<th style="text-align:center">countryOfIncorporation</th>
			<th style="text-align:center">bic</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @financialInstitutions.each do |financialInstitution| %>
		<tr>   
			<td style="text-align:center">
	  			<%= financialInstitution.name %>
			</td>
			<td style="text-align:center">
	  			<%= financialInstitution.legalName %>
			</td>
			<td style="text-align:center">
	  			<%= financialInstitution.countryOfIncorporation %>
			</td>
			<td style="text-align:center">
	  			<%= financialInstitution.bic %>
			</td>
			<td style="text-align:center">
	  			<%= financialInstitution.website %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_financialInstitution_path(financialInstitution), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', financialInstitution_path(financialInstitution), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New FinancialInstitution', new_financialInstitution_path, :method => :get, :class => "btn btn-success btn-sm" %>