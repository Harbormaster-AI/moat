<div class="title text-center">
  List of InvestmentPortfolios
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">portfolioCode</th>
			<th style="text-align:center">baseCurrency</th>
			<th style="text-align:center">createdAt</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @investmentPortfolios.each do |investmentPortfolio| %>
		<tr>   
			<td style="text-align:center">
	  			<%= investmentPortfolio.portfolioCode %>
			</td>
			<td style="text-align:center">
	  			<%= investmentPortfolio.baseCurrency %>
			</td>
			<td style="text-align:center">
	  			<%= investmentPortfolio.createdAt %>
			</td>
			<td style="text-align:center">
	  			<%= investmentPortfolio.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_investmentPortfolio_path(investmentPortfolio), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', investmentPortfolio_path(investmentPortfolio), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InvestmentPortfolio', new_investmentPortfolio_path, :method => :get, :class => "btn btn-success btn-sm" %>