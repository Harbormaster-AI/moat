<div class="title text-center">
  List of LoanTransactions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">transactionId</th>
			<th style="text-align:center">amount</th>
			<th style="text-align:center">postingDate</th>
			<th style="text-align:center">Type</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @loanTransactions.each do |loanTransaction| %>
		<tr>   
			<td style="text-align:center">
	  			<%= loanTransaction.transactionId %>
			</td>
			<td style="text-align:center">
	  			<%= loanTransaction.amount %>
			</td>
			<td style="text-align:center">
	  			<%= loanTransaction.postingDate %>
			</td>
			<td style="text-align:center">
	  			<%= loanTransaction.Type %>
			</td>
			<td style="text-align:center">
	  			<%= loanTransaction.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_loanTransaction_path(loanTransaction), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', loanTransaction_path(loanTransaction), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New LoanTransaction', new_loanTransaction_path, :method => :get, :class => "btn btn-success btn-sm" %>