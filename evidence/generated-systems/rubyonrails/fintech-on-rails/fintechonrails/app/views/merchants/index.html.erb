<div class="title text-center">
  List of Merchants
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">mcc</th>
			<th style="text-align:center">url</th>
			<th style="text-align:center">country</th>
			<th style="text-align:center">settlementCurrency</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @merchants.each do |merchant| %>
		<tr>   
			<td style="text-align:center">
	  			<%= merchant.name %>
			</td>
			<td style="text-align:center">
	  			<%= merchant.mcc %>
			</td>
			<td style="text-align:center">
	  			<%= merchant.url %>
			</td>
			<td style="text-align:center">
	  			<%= merchant.country %>
			</td>
			<td style="text-align:center">
	  			<%= merchant.settlementCurrency %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_merchant_path(merchant), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', merchant_path(merchant), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Merchant', new_merchant_path, :method => :get, :class => "btn btn-success btn-sm" %>