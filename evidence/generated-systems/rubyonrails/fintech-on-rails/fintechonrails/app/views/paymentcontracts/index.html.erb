<div class="title text-center">
  List of PaymentContracts
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">contractNumber</th>
			<th style="text-align:center">pricingPlanCode</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @paymentContracts.each do |paymentContract| %>
		<tr>   
			<td style="text-align:center">
	  			<%= paymentContract.contractNumber %>
			</td>
			<td style="text-align:center">
	  			<%= paymentContract.pricingPlanCode %>
			</td>
			<td style="text-align:center">
	  			<%= paymentContract.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_paymentContract_path(paymentContract), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', paymentContract_path(paymentContract), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PaymentContract', new_paymentContract_path, :method => :get, :class => "btn btn-success btn-sm" %>