<div class="title text-center">
  List of PaymentProcessors
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">processorCode</th>
			<th style="text-align:center">networkSupport</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @paymentProcessors.each do |paymentProcessor| %>
		<tr>   
			<td style="text-align:center">
	  			<%= paymentProcessor.name %>
			</td>
			<td style="text-align:center">
	  			<%= paymentProcessor.processorCode %>
			</td>
			<td style="text-align:center">
	  			<%= paymentProcessor.networkSupport %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_paymentProcessor_path(paymentProcessor), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', paymentProcessor_path(paymentProcessor), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PaymentProcessor', new_paymentProcessor_path, :method => :get, :class => "btn btn-success btn-sm" %>