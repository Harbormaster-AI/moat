<div class="title text-center">
  List of PricingPlans
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">planCode</th>
			<th style="text-align:center">baseCurrency</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @pricingPlans.each do |pricingPlan| %>
		<tr>   
			<td style="text-align:center">
	  			<%= pricingPlan.name %>
			</td>
			<td style="text-align:center">
	  			<%= pricingPlan.planCode %>
			</td>
			<td style="text-align:center">
	  			<%= pricingPlan.baseCurrency %>
			</td>
			<td style="text-align:center">
	  			<%= pricingPlan.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_pricingPlan_path(pricingPlan), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', pricingPlan_path(pricingPlan), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PricingPlan', new_pricingPlan_path, :method => :get, :class => "btn btn-success btn-sm" %>