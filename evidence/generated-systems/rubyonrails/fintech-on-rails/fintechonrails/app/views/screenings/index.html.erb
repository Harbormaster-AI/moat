<div class="title text-center">
  List of Screenings
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">score</th>
			<th style="text-align:center">screenedAt</th>
			<th style="text-align:center">ScreeningType</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @screenings.each do |screening| %>
		<tr>   
			<td style="text-align:center">
	  			<%= screening.score %>
			</td>
			<td style="text-align:center">
	  			<%= screening.screenedAt %>
			</td>
			<td style="text-align:center">
	  			<%= screening.ScreeningType %>
			</td>
			<td style="text-align:center">
	  			<%= screening.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_screening_path(screening), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', screening_path(screening), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Screening', new_screening_path, :method => :get, :class => "btn btn-success btn-sm" %>