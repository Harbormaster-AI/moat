<div class="title text-center">
  List of SettlementBatchs
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">batchId</th>
			<th style="text-align:center">periodStart</th>
			<th style="text-align:center">periodEnd</th>
			<th style="text-align:center">totalVolume</th>
			<th style="text-align:center">totalCount</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @settlementBatchs.each do |settlementBatch| %>
		<tr>   
			<td style="text-align:center">
	  			<%= settlementBatch.batchId %>
			</td>
			<td style="text-align:center">
	  			<%= settlementBatch.periodStart %>
			</td>
			<td style="text-align:center">
	  			<%= settlementBatch.periodEnd %>
			</td>
			<td style="text-align:center">
	  			<%= settlementBatch.totalVolume %>
			</td>
			<td style="text-align:center">
	  			<%= settlementBatch.totalCount %>
			</td>
			<td style="text-align:center">
	  			<%= settlementBatch.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_settlementBatch_path(settlementBatch), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', settlementBatch_path(settlementBatch), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New SettlementBatch', new_settlementBatch_path, :method => :get, :class => "btn btn-success btn-sm" %>