<div class="title text-center">
  List of Terminals
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">location</th>
			<th style="text-align:center">Type</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @terminals.each do |terminal| %>
		<tr>   
			<td style="text-align:center">
	  			<%= terminal.location %>
			</td>
			<td style="text-align:center">
	  			<%= terminal.Type %>
			</td>
			<td style="text-align:center">
	  			<%= terminal.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_terminal_path(terminal), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', terminal_path(terminal), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Terminal', new_terminal_path, :method => :get, :class => "btn btn-success btn-sm" %>