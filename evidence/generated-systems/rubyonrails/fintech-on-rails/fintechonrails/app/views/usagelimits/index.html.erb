<div class="title text-center">
  List of UsageLimits
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">amount</th>
			<th style="text-align:center">count</th>
			<th style="text-align:center">Scope</th>
			<th style="text-align:center">Period</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @usageLimits.each do |usageLimit| %>
		<tr>   
			<td style="text-align:center">
	  			<%= usageLimit.name %>
			</td>
			<td style="text-align:center">
	  			<%= usageLimit.amount %>
			</td>
			<td style="text-align:center">
	  			<%= usageLimit.count %>
			</td>
			<td style="text-align:center">
	  			<%= usageLimit.Scope %>
			</td>
			<td style="text-align:center">
	  			<%= usageLimit.Period %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_usageLimit_path(usageLimit), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', usageLimit_path(usageLimit), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New UsageLimit', new_usageLimit_path, :method => :get, :class => "btn btn-success btn-sm" %>