<div class="title text-center">
  List of AuditEngagements
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">title</th>
			<th style="text-align:center">startDate</th>
			<th style="text-align:center">endDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @auditEngagements.each do |auditEngagement| %>
		<tr>   
			<td style="text-align:center">
	  			<%= auditEngagement.title %>
			</td>
			<td style="text-align:center">
	  			<%= auditEngagement.startDate %>
			</td>
			<td style="text-align:center">
	  			<%= auditEngagement.endDate %>
			</td>
			<td style="text-align:center">
	  			<%= auditEngagement.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_auditEngagement_path(auditEngagement), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', auditEngagement_path(auditEngagement), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AuditEngagement', new_auditEngagement_path, :method => :get, :class => "btn btn-success btn-sm" %>