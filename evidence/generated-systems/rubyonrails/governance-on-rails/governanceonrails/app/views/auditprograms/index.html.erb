<div class="title text-center">
  List of AuditPrograms
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">scope</th>
			<th style="text-align:center">Cycle</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @auditPrograms.each do |auditProgram| %>
		<tr>   
			<td style="text-align:center">
	  			<%= auditProgram.name %>
			</td>
			<td style="text-align:center">
	  			<%= auditProgram.scope %>
			</td>
			<td style="text-align:center">
	  			<%= auditProgram.Cycle %>
			</td>
			<td style="text-align:center">
	  			<%= auditProgram.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_auditProgram_path(auditProgram), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', auditProgram_path(auditProgram), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AuditProgram', new_auditProgram_path, :method => :get, :class => "btn btn-success btn-sm" %>