<div class="title text-center">
  List of ControlTest_s
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">testPeriodStart</th>
			<th style="text-align:center">testPeriodEnd</th>
			<th style="text-align:center">sampleSize</th>
			<th style="text-align:center">TestType</th>
			<th style="text-align:center">Effectiveness</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @controlTest_s.each do |controlTest_| %>
		<tr>   
			<td style="text-align:center">
	  			<%= controlTest_.name %>
			</td>
			<td style="text-align:center">
	  			<%= controlTest_.testPeriodStart %>
			</td>
			<td style="text-align:center">
	  			<%= controlTest_.testPeriodEnd %>
			</td>
			<td style="text-align:center">
	  			<%= controlTest_.sampleSize %>
			</td>
			<td style="text-align:center">
	  			<%= controlTest_.TestType %>
			</td>
			<td style="text-align:center">
	  			<%= controlTest_.Effectiveness %>
			</td>
			<td style="text-align:center">
	  			<%= controlTest_.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_controlTest__path(controlTest_), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', controlTest__path(controlTest_), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ControlTest_', new_controlTest__path, :method => :get, :class => "btn btn-success btn-sm" %>