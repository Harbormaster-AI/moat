<div class="title text-center">
  List of DataProcessingActivitys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">purpose</th>
			<th style="text-align:center">startDate</th>
			<th style="text-align:center">LawfulBasis</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dataProcessingActivitys.each do |dataProcessingActivity| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dataProcessingActivity.name %>
			</td>
			<td style="text-align:center">
	  			<%= dataProcessingActivity.purpose %>
			</td>
			<td style="text-align:center">
	  			<%= dataProcessingActivity.startDate %>
			</td>
			<td style="text-align:center">
	  			<%= dataProcessingActivity.LawfulBasis %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dataProcessingActivity_path(dataProcessingActivity), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dataProcessingActivity_path(dataProcessingActivity), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DataProcessingActivity', new_dataProcessingActivity_path, :method => :get, :class => "btn btn-success btn-sm" %>