<div class="title text-center">
  List of DispositionReviews
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">reviewDate</th>
			<th style="text-align:center">reviewer</th>
			<th style="text-align:center">notes</th>
			<th style="text-align:center">Outcome</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dispositionReviews.each do |dispositionReview| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dispositionReview.reviewDate %>
			</td>
			<td style="text-align:center">
	  			<%= dispositionReview.reviewer %>
			</td>
			<td style="text-align:center">
	  			<%= dispositionReview.notes %>
			</td>
			<td style="text-align:center">
	  			<%= dispositionReview.Outcome %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dispositionReview_path(dispositionReview), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dispositionReview_path(dispositionReview), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DispositionReview', new_dispositionReview_path, :method => :get, :class => "btn btn-success btn-sm" %>