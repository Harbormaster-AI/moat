<div class="title text-center">
  List of LegalHolds
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">reason</th>
			<th style="text-align:center">issuedDate</th>
			<th style="text-align:center">releaseDate</th>
			<th style="text-align:center">HoldStatus</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @legalHolds.each do |legalHold| %>
		<tr>   
			<td style="text-align:center">
	  			<%= legalHold.name %>
			</td>
			<td style="text-align:center">
	  			<%= legalHold.reason %>
			</td>
			<td style="text-align:center">
	  			<%= legalHold.issuedDate %>
			</td>
			<td style="text-align:center">
	  			<%= legalHold.releaseDate %>
			</td>
			<td style="text-align:center">
	  			<%= legalHold.HoldStatus %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_legalHold_path(legalHold), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', legalHold_path(legalHold), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New LegalHold', new_legalHold_path, :method => :get, :class => "btn btn-success btn-sm" %>