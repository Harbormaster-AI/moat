<div class="title text-center">
  List of Obligations
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">referenceNumber</th>
			<th style="text-align:center">descriptionText</th>
			<th style="text-align:center">ObligationType</th>
			<th style="text-align:center">ReviewFrequency</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @obligations.each do |obligation| %>
		<tr>   
			<td style="text-align:center">
	  			<%= obligation.referenceNumber %>
			</td>
			<td style="text-align:center">
	  			<%= obligation.descriptionText %>
			</td>
			<td style="text-align:center">
	  			<%= obligation.ObligationType %>
			</td>
			<td style="text-align:center">
	  			<%= obligation.ReviewFrequency %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_obligation_path(obligation), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', obligation_path(obligation), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Obligation', new_obligation_path, :method => :get, :class => "btn btn-success btn-sm" %>