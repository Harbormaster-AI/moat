<div class="title text-center">
  List of Procedures
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">title</th>
			<th style="text-align:center">versionLabel</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @procedures.each do |procedure| %>
		<tr>   
			<td style="text-align:center">
	  			<%= procedure.title %>
			</td>
			<td style="text-align:center">
	  			<%= procedure.versionLabel %>
			</td>
			<td style="text-align:center">
	  			<%= procedure.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_procedure_path(procedure), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', procedure_path(procedure), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Procedure', new_procedure_path, :method => :get, :class => "btn btn-success btn-sm" %>