<div class="title text-center">
  List of RecordsRepositorys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">location</th>
			<th style="text-align:center">ownerDepartment</th>
			<th style="text-align:center">RepositoryType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @recordsRepositorys.each do |recordsRepository| %>
		<tr>   
			<td style="text-align:center">
	  			<%= recordsRepository.name %>
			</td>
			<td style="text-align:center">
	  			<%= recordsRepository.location %>
			</td>
			<td style="text-align:center">
	  			<%= recordsRepository.ownerDepartment %>
			</td>
			<td style="text-align:center">
	  			<%= recordsRepository.RepositoryType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_recordsRepository_path(recordsRepository), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', recordsRepository_path(recordsRepository), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New RecordsRepository', new_recordsRepository_path, :method => :get, :class => "btn btn-success btn-sm" %>