<div class="title text-center">
  List of RoleAssignments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">effectiveFrom</th>
			<th style="text-align:center">effectiveTo</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @roleAssignments.each do |roleAssignment| %>
		<tr>   
			<td style="text-align:center">
	  			<%= roleAssignment.effectiveFrom %>
			</td>
			<td style="text-align:center">
	  			<%= roleAssignment.effectiveTo %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_roleAssignment_path(roleAssignment), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', roleAssignment_path(roleAssignment), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New RoleAssignment', new_roleAssignment_path, :method => :get, :class => "btn btn-success btn-sm" %>