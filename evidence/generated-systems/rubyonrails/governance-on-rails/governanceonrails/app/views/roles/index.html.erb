<div class="title text-center">
  List of Roles
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">responsibility</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @roles.each do |role| %>
		<tr>   
			<td style="text-align:center">
	  			<%= role.name %>
			</td>
			<td style="text-align:center">
	  			<%= role.responsibility %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_role_path(role), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', role_path(role), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Role', new_role_path, :method => :get, :class => "btn btn-success btn-sm" %>