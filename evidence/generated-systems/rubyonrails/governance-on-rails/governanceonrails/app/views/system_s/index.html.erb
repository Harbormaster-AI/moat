<div class="title text-center">
  List of System_s
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">ownerDepartment</th>
			<th style="text-align:center">SystemType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @system_s.each do |system_| %>
		<tr>   
			<td style="text-align:center">
	  			<%= system_.name %>
			</td>
			<td style="text-align:center">
	  			<%= system_.ownerDepartment %>
			</td>
			<td style="text-align:center">
	  			<%= system_.SystemType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_system__path(system_), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', system__path(system_), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New System_', new_system__path, :method => :get, :class => "btn btn-success btn-sm" %>