<div class="title text-center">
  List of ThirdPartyAssessments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">assessmentDate</th>
			<th style="text-align:center">assessor</th>
			<th style="text-align:center">AssessmentType</th>
			<th style="text-align:center">Result</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @thirdPartyAssessments.each do |thirdPartyAssessment| %>
		<tr>   
			<td style="text-align:center">
	  			<%= thirdPartyAssessment.assessmentDate %>
			</td>
			<td style="text-align:center">
	  			<%= thirdPartyAssessment.assessor %>
			</td>
			<td style="text-align:center">
	  			<%= thirdPartyAssessment.AssessmentType %>
			</td>
			<td style="text-align:center">
	  			<%= thirdPartyAssessment.Result %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_thirdPartyAssessment_path(thirdPartyAssessment), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', thirdPartyAssessment_path(thirdPartyAssessment), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ThirdPartyAssessment', new_thirdPartyAssessment_path, :method => :get, :class => "btn btn-success btn-sm" %>