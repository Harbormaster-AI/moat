<div class="title text-center">
  List of ThirdPartys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">country</th>
			<th style="text-align:center">contactEmail</th>
			<th style="text-align:center">ThirdPartyType</th>
			<th style="text-align:center">Criticality</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @thirdPartys.each do |thirdParty| %>
		<tr>   
			<td style="text-align:center">
	  			<%= thirdParty.name %>
			</td>
			<td style="text-align:center">
	  			<%= thirdParty.country %>
			</td>
			<td style="text-align:center">
	  			<%= thirdParty.contactEmail %>
			</td>
			<td style="text-align:center">
	  			<%= thirdParty.ThirdPartyType %>
			</td>
			<td style="text-align:center">
	  			<%= thirdParty.Criticality %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_thirdParty_path(thirdParty), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', thirdParty_path(thirdParty), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ThirdParty', new_thirdParty_path, :method => :get, :class => "btn btn-success btn-sm" %>