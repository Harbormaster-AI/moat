<div class="title text-center">
  List of Allergys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">substance</th>
			<th style="text-align:center">reaction</th>
			<th style="text-align:center">Severity</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @allergys.each do |allergy| %>
		<tr>   
			<td style="text-align:center">
	  			<%= allergy.substance %>
			</td>
			<td style="text-align:center">
	  			<%= allergy.reaction %>
			</td>
			<td style="text-align:center">
	  			<%= allergy.Severity %>
			</td>
			<td style="text-align:center">
	  			<%= allergy.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_allergy_path(allergy), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', allergy_path(allergy), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Allergy', new_allergy_path, :method => :get, :class => "btn btn-success btn-sm" %>