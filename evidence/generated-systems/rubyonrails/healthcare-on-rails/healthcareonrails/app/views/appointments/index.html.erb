<div class="title text-center">
  List of Appointments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">appointmentDate</th>
			<th style="text-align:center">reason</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center">Priority</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @appointments.each do |appointment| %>
		<tr>   
			<td style="text-align:center">
	  			<%= appointment.appointmentDate %>
			</td>
			<td style="text-align:center">
	  			<%= appointment.reason %>
			</td>
			<td style="text-align:center">
	  			<%= appointment.Status %>
			</td>
			<td style="text-align:center">
	  			<%= appointment.Priority %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_appointment_path(appointment), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', appointment_path(appointment), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Appointment', new_appointment_path, :method => :get, :class => "btn btn-success btn-sm" %>