<div class="title text-center">
  List of Authorizations
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">authNumber</th>
			<th style="text-align:center">requestedService</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @authorizations.each do |authorization| %>
		<tr>   
			<td style="text-align:center">
	  			<%= authorization.authNumber %>
			</td>
			<td style="text-align:center">
	  			<%= authorization.requestedService %>
			</td>
			<td style="text-align:center">
	  			<%= authorization.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_authorization_path(authorization), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', authorization_path(authorization), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Authorization', new_authorization_path, :method => :get, :class => "btn btn-success btn-sm" %>