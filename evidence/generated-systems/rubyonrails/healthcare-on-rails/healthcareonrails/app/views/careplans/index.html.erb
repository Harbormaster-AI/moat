<div class="title text-center">
  List of CarePlans
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">planNumber</th>
			<th style="text-align:center">goalSummary</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @carePlans.each do |carePlan| %>
		<tr>   
			<td style="text-align:center">
	  			<%= carePlan.planNumber %>
			</td>
			<td style="text-align:center">
	  			<%= carePlan.goalSummary %>
			</td>
			<td style="text-align:center">
	  			<%= carePlan.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_carePlan_path(carePlan), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', carePlan_path(carePlan), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CarePlan', new_carePlan_path, :method => :get, :class => "btn btn-success btn-sm" %>