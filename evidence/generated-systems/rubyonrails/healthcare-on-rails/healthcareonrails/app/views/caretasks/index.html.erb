<div class="title text-center">
  List of CareTasks
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">description</th>
			<th style="text-align:center">dueDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center">Priority</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @careTasks.each do |careTask| %>
		<tr>   
			<td style="text-align:center">
	  			<%= careTask.description %>
			</td>
			<td style="text-align:center">
	  			<%= careTask.dueDate %>
			</td>
			<td style="text-align:center">
	  			<%= careTask.Status %>
			</td>
			<td style="text-align:center">
	  			<%= careTask.Priority %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_careTask_path(careTask), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', careTask_path(careTask), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CareTask', new_careTask_path, :method => :get, :class => "btn btn-success btn-sm" %>