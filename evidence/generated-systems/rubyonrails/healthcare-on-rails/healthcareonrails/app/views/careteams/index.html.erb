<div class="title text-center">
  List of CareTeams
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">CareSetting</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @careTeams.each do |careTeam| %>
		<tr>   
			<td style="text-align:center">
	  			<%= careTeam.name %>
			</td>
			<td style="text-align:center">
	  			<%= careTeam.CareSetting %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_careTeam_path(careTeam), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', careTeam_path(careTeam), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CareTeam', new_careTeam_path, :method => :get, :class => "btn btn-success btn-sm" %>