<div class="title text-center">
  List of Coverages
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">memberId</th>
			<th style="text-align:center">groupNumber</th>
			<th style="text-align:center">effectiveDate</th>
			<th style="text-align:center">endDate</th>
			<th style="text-align:center">CoverageType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @coverages.each do |coverage| %>
		<tr>   
			<td style="text-align:center">
	  			<%= coverage.memberId %>
			</td>
			<td style="text-align:center">
	  			<%= coverage.groupNumber %>
			</td>
			<td style="text-align:center">
	  			<%= coverage.effectiveDate %>
			</td>
			<td style="text-align:center">
	  			<%= coverage.endDate %>
			</td>
			<td style="text-align:center">
	  			<%= coverage.CoverageType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_coverage_path(coverage), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', coverage_path(coverage), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Coverage', new_coverage_path, :method => :get, :class => "btn btn-success btn-sm" %>