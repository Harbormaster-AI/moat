<div class="title text-center">
  List of Departments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">DepartmentType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @departments.each do |department| %>
		<tr>   
			<td style="text-align:center">
	  			<%= department.name %>
			</td>
			<td style="text-align:center">
	  			<%= department.DepartmentType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_department_path(department), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', department_path(department), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Department', new_department_path, :method => :get, :class => "btn btn-success btn-sm" %>