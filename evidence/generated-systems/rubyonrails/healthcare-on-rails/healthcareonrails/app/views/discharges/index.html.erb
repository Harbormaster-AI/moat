<div class="title text-center">
  List of Discharges
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">dischargeDateTime</th>
			<th style="text-align:center">Disposition</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @discharges.each do |discharge| %>
		<tr>   
			<td style="text-align:center">
	  			<%= discharge.dischargeDateTime %>
			</td>
			<td style="text-align:center">
	  			<%= discharge.Disposition %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_discharge_path(discharge), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', discharge_path(discharge), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Discharge', new_discharge_path, :method => :get, :class => "btn btn-success btn-sm" %>