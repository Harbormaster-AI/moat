<div class="title text-center">
  List of Encounters
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">encounterNumber</th>
			<th style="text-align:center">startDateTime</th>
			<th style="text-align:center">endDateTime</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center">EncounterType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @encounters.each do |encounter| %>
		<tr>   
			<td style="text-align:center">
	  			<%= encounter.encounterNumber %>
			</td>
			<td style="text-align:center">
	  			<%= encounter.startDateTime %>
			</td>
			<td style="text-align:center">
	  			<%= encounter.endDateTime %>
			</td>
			<td style="text-align:center">
	  			<%= encounter.Status %>
			</td>
			<td style="text-align:center">
	  			<%= encounter.EncounterType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_encounter_path(encounter), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', encounter_path(encounter), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Encounter', new_encounter_path, :method => :get, :class => "btn btn-success btn-sm" %>