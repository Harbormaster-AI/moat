<div class="title text-center">
  List of Facilitys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">facilityCode</th>
			<th style="text-align:center">address</th>
			<th style="text-align:center">FacilityType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @facilitys.each do |facility| %>
		<tr>   
			<td style="text-align:center">
	  			<%= facility.name %>
			</td>
			<td style="text-align:center">
	  			<%= facility.facilityCode %>
			</td>
			<td style="text-align:center">
	  			<%= facility.address %>
			</td>
			<td style="text-align:center">
	  			<%= facility.FacilityType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_facility_path(facility), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', facility_path(facility), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Facility', new_facility_path, :method => :get, :class => "btn btn-success btn-sm" %>