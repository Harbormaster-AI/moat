<div class="title text-center">
  List of HealthSystems
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">legalName</th>
			<th style="text-align:center">headquartersCountry</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @healthSystems.each do |healthSystem| %>
		<tr>   
			<td style="text-align:center">
	  			<%= healthSystem.name %>
			</td>
			<td style="text-align:center">
	  			<%= healthSystem.legalName %>
			</td>
			<td style="text-align:center">
	  			<%= healthSystem.headquartersCountry %>
			</td>
			<td style="text-align:center">
	  			<%= healthSystem.website %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_healthSystem_path(healthSystem), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', healthSystem_path(healthSystem), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New HealthSystem', new_healthSystem_path, :method => :get, :class => "btn btn-success btn-sm" %>