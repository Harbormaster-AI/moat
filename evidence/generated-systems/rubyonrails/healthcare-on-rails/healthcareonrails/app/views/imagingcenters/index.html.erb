<div class="title text-center">
  List of ImagingCenters
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @imagingCenters.each do |imagingCenter| %>
		<tr>   
			<td style="text-align:center">
	  			<%= imagingCenter.name %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_imagingCenter_path(imagingCenter), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', imagingCenter_path(imagingCenter), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ImagingCenter', new_imagingCenter_path, :method => :get, :class => "btn btn-success btn-sm" %>