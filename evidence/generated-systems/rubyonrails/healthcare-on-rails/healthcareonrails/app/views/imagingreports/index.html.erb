<div class="title text-center">
  List of ImagingReports
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">reportNumber</th>
			<th style="text-align:center">impression</th>
			<th style="text-align:center">reportedDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @imagingReports.each do |imagingReport| %>
		<tr>   
			<td style="text-align:center">
	  			<%= imagingReport.reportNumber %>
			</td>
			<td style="text-align:center">
	  			<%= imagingReport.impression %>
			</td>
			<td style="text-align:center">
	  			<%= imagingReport.reportedDate %>
			</td>
			<td style="text-align:center">
	  			<%= imagingReport.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_imagingReport_path(imagingReport), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', imagingReport_path(imagingReport), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ImagingReport', new_imagingReport_path, :method => :get, :class => "btn btn-success btn-sm" %>