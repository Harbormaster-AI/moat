<div class="title text-center">
  List of InsurancePayers
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center">PayerType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @insurancePayers.each do |insurancePayer| %>
		<tr>   
			<td style="text-align:center">
	  			<%= insurancePayer.name %>
			</td>
			<td style="text-align:center">
	  			<%= insurancePayer.website %>
			</td>
			<td style="text-align:center">
	  			<%= insurancePayer.PayerType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_insurancePayer_path(insurancePayer), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', insurancePayer_path(insurancePayer), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InsurancePayer', new_insurancePayer_path, :method => :get, :class => "btn btn-success btn-sm" %>