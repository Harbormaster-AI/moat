<div class="title text-center">
  List of InsurancePlans
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">planCode</th>
			<th style="text-align:center">PlanType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @insurancePlans.each do |insurancePlan| %>
		<tr>   
			<td style="text-align:center">
	  			<%= insurancePlan.name %>
			</td>
			<td style="text-align:center">
	  			<%= insurancePlan.planCode %>
			</td>
			<td style="text-align:center">
	  			<%= insurancePlan.PlanType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_insurancePlan_path(insurancePlan), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', insurancePlan_path(insurancePlan), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InsurancePlan', new_insurancePlan_path, :method => :get, :class => "btn btn-success btn-sm" %>