<div class="title text-center">
  List of InventoryItems
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">sku</th>
			<th style="text-align:center">name</th>
			<th style="text-align:center">quantityOnHand</th>
			<th style="text-align:center">quantityReserved</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @inventoryItems.each do |inventoryItem| %>
		<tr>   
			<td style="text-align:center">
	  			<%= inventoryItem.sku %>
			</td>
			<td style="text-align:center">
	  			<%= inventoryItem.name %>
			</td>
			<td style="text-align:center">
	  			<%= inventoryItem.quantityOnHand %>
			</td>
			<td style="text-align:center">
	  			<%= inventoryItem.quantityReserved %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_inventoryItem_path(inventoryItem), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', inventoryItem_path(inventoryItem), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InventoryItem', new_inventoryItem_path, :method => :get, :class => "btn btn-success btn-sm" %>