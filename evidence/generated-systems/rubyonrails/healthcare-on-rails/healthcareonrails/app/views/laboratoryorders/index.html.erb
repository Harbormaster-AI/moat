<div class="title text-center">
  List of LaboratoryOrders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">testCode</th>
			<th style="text-align:center">fastingRequired</th>
			<th style="text-align:center">SpecimenType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @laboratoryOrders.each do |laboratoryOrder| %>
		<tr>   
			<td style="text-align:center">
	  			<%= laboratoryOrder.testCode %>
			</td>
			<td style="text-align:center">
	  			<%= laboratoryOrder.fastingRequired %>
			</td>
			<td style="text-align:center">
	  			<%= laboratoryOrder.SpecimenType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_laboratoryOrder_path(laboratoryOrder), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', laboratoryOrder_path(laboratoryOrder), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New LaboratoryOrder', new_laboratoryOrder_path, :method => :get, :class => "btn btn-success btn-sm" %>