<div class="title text-center">
  List of Laboratorys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">cliaNumber</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @laboratorys.each do |laboratory| %>
		<tr>   
			<td style="text-align:center">
	  			<%= laboratory.name %>
			</td>
			<td style="text-align:center">
	  			<%= laboratory.cliaNumber %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_laboratory_path(laboratory), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', laboratory_path(laboratory), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Laboratory', new_laboratory_path, :method => :get, :class => "btn btn-success btn-sm" %>