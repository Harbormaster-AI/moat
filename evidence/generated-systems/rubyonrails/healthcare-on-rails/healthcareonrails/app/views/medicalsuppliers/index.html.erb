<div class="title text-center">
  List of MedicalSuppliers
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center">SupplierTier</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @medicalSuppliers.each do |medicalSupplier| %>
		<tr>   
			<td style="text-align:center">
	  			<%= medicalSupplier.name %>
			</td>
			<td style="text-align:center">
	  			<%= medicalSupplier.website %>
			</td>
			<td style="text-align:center">
	  			<%= medicalSupplier.SupplierTier %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_medicalSupplier_path(medicalSupplier), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', medicalSupplier_path(medicalSupplier), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New MedicalSupplier', new_medicalSupplier_path, :method => :get, :class => "btn btn-success btn-sm" %>