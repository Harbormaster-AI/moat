<%= form_with model: @payment, local: true do |form| %>
 
  <% if @payment.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@payment.errors.count, "error") %> prohibited
        this payment from being saved:
      </h2>
      <ul>
        <% @payment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="card">
    <div class="card-body">

  <p>
    <%= form.label :paymentNumber, { class: 'form-label'} %><br>
	<%= form.text_field :paymentNumber, { class: 'form-label'} %>
  </p>			
  <p>
    <%= form.label :amount, { class: 'form-label'} %><br>
	<%= form.text_field :amount, { class: 'form-label'} %>
  </p>			
  <p>
    <%= form.label :paymentDate, { class: 'form-label'} %><br>
    <%= form.date_field :paymentDate, { class: 'form-label'} %>
  </p>			
  <p>
  </p>			
  <p>
  </p>			
  <p>
   <%= form.label :Method, { class: 'form-label'} %><br>
   <%= form.select :Method, Payment.Methods.keys, { class: 'form-control'} %>
  </p>			

      <%= form.submit %>
    
    </div>
  
  </div> 
<% end %>