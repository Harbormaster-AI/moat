<div class="title text-center">
  List of ProcedureOrders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">procedureCode</th>
			<th style="text-align:center">consentObtained</th>
			<th style="text-align:center">AnesthesiaType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @procedureOrders.each do |procedureOrder| %>
		<tr>   
			<td style="text-align:center">
	  			<%= procedureOrder.procedureCode %>
			</td>
			<td style="text-align:center">
	  			<%= procedureOrder.consentObtained %>
			</td>
			<td style="text-align:center">
	  			<%= procedureOrder.AnesthesiaType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_procedureOrder_path(procedureOrder), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', procedureOrder_path(procedureOrder), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ProcedureOrder', new_procedureOrder_path, :method => :get, :class => "btn btn-success btn-sm" %>