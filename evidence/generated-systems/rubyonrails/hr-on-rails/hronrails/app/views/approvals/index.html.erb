<div class="title text-center">
  List of Approvals
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">approverComment</th>
			<th style="text-align:center">actionDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @approvals.each do |approval| %>
		<tr>   
			<td style="text-align:center">
	  			<%= approval.approverComment %>
			</td>
			<td style="text-align:center">
	  			<%= approval.actionDate %>
			</td>
			<td style="text-align:center">
	  			<%= approval.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_approval_path(approval), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', approval_path(approval), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Approval', new_approval_path, :method => :get, :class => "btn btn-success btn-sm" %>