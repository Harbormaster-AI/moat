<div class="title text-center">
  List of BenefitPlans
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">providerName</th>
			<th style="text-align:center">employeeContributionRate</th>
			<th style="text-align:center">employerContributionRate</th>
			<th style="text-align:center">eligibilityRules</th>
			<th style="text-align:center">BenefitType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @benefitPlans.each do |benefitPlan| %>
		<tr>   
			<td style="text-align:center">
	  			<%= benefitPlan.name %>
			</td>
			<td style="text-align:center">
	  			<%= benefitPlan.providerName %>
			</td>
			<td style="text-align:center">
	  			<%= benefitPlan.employeeContributionRate %>
			</td>
			<td style="text-align:center">
	  			<%= benefitPlan.employerContributionRate %>
			</td>
			<td style="text-align:center">
	  			<%= benefitPlan.eligibilityRules %>
			</td>
			<td style="text-align:center">
	  			<%= benefitPlan.BenefitType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_benefitPlan_path(benefitPlan), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', benefitPlan_path(benefitPlan), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New BenefitPlan', new_benefitPlan_path, :method => :get, :class => "btn btn-success btn-sm" %>