<div class="title text-center">
  List of BonusPlans
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">targetPercentage</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @bonusPlans.each do |bonusPlan| %>
		<tr>   
			<td style="text-align:center">
	  			<%= bonusPlan.name %>
			</td>
			<td style="text-align:center">
	  			<%= bonusPlan.targetPercentage %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_bonusPlan_path(bonusPlan), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', bonusPlan_path(bonusPlan), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New BonusPlan', new_bonusPlan_path, :method => :get, :class => "btn btn-success btn-sm" %>