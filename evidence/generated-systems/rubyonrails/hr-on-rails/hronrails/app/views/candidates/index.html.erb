<div class="title text-center">
  List of Candidates
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">email</th>
			<th style="text-align:center">phone</th>
			<th style="text-align:center">Source</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @candidates.each do |candidate| %>
		<tr>   
			<td style="text-align:center">
	  			<%= candidate.name %>
			</td>
			<td style="text-align:center">
	  			<%= candidate.email %>
			</td>
			<td style="text-align:center">
	  			<%= candidate.phone %>
			</td>
			<td style="text-align:center">
	  			<%= candidate.Source %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_candidate_path(candidate), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', candidate_path(candidate), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Candidate', new_candidate_path, :method => :get, :class => "btn btn-success btn-sm" %>