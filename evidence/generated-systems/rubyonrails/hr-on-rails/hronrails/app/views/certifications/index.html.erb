<div class="title text-center">
  List of Certifications
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">issuer</th>
			<th style="text-align:center">validFrom</th>
			<th style="text-align:center">validTo</th>
			<th style="text-align:center">credentialId</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @certifications.each do |certification| %>
		<tr>   
			<td style="text-align:center">
	  			<%= certification.name %>
			</td>
			<td style="text-align:center">
	  			<%= certification.issuer %>
			</td>
			<td style="text-align:center">
	  			<%= certification.validFrom %>
			</td>
			<td style="text-align:center">
	  			<%= certification.validTo %>
			</td>
			<td style="text-align:center">
	  			<%= certification.credentialId %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_certification_path(certification), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', certification_path(certification), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Certification', new_certification_path, :method => :get, :class => "btn btn-success btn-sm" %>