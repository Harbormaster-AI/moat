<div class="title text-center">
  List of CompensationPackages
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">effectiveFrom</th>
			<th style="text-align:center">effectiveTo</th>
			<th style="text-align:center">currency</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @compensationPackages.each do |compensationPackage| %>
		<tr>   
			<td style="text-align:center">
	  			<%= compensationPackage.effectiveFrom %>
			</td>
			<td style="text-align:center">
	  			<%= compensationPackage.effectiveTo %>
			</td>
			<td style="text-align:center">
	  			<%= compensationPackage.currency %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_compensationPackage_path(compensationPackage), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', compensationPackage_path(compensationPackage), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CompensationPackage', new_compensationPackage_path, :method => :get, :class => "btn btn-success btn-sm" %>