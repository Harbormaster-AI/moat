<div class="title text-center">
  List of Competencys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">category</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @competencys.each do |competency| %>
		<tr>   
			<td style="text-align:center">
	  			<%= competency.name %>
			</td>
			<td style="text-align:center">
	  			<%= competency.category %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_competency_path(competency), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', competency_path(competency), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Competency', new_competency_path, :method => :get, :class => "btn btn-success btn-sm" %>