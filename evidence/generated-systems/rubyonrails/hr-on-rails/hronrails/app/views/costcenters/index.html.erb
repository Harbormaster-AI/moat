<div class="title text-center">
  List of CostCenters
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">code</th>
			<th style="text-align:center">name</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @costCenters.each do |costCenter| %>
		<tr>   
			<td style="text-align:center">
	  			<%= costCenter.code %>
			</td>
			<td style="text-align:center">
	  			<%= costCenter.name %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_costCenter_path(costCenter), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', costCenter_path(costCenter), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CostCenter', new_costCenter_path, :method => :get, :class => "btn btn-success btn-sm" %>