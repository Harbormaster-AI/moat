    <%= form.label :birthDate, { class: 'form-label'} %><br>
    <%= form.date_field :birthDate, { class: 'form-label'} %>
  </p>			
  <p>
  </p>			
  <p>
  </p>			
  <p>
   <%= form.label :Relationship, { class: 'form-label'} %><br>
   <%= form.select :Relationship, Dependent.Relationships.keys, { class: 'form-control'} %>
  </p>			

      <%= form.submit %>
    
    </div>
  
  </div> 
<% end %>