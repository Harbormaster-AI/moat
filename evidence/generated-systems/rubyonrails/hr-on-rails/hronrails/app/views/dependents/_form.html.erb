<%= form_with model: @dependent, local: true do |form| %>
 
  <% if @dependent.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@dependent.errors.count, "error") %> prohibited
        this dependent from being saved:
      </h2>
      <ul>
        <% @dependent.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="card">
    <div class="card-body">

  <p>
