<div class="title text-center">
  List of Dependents
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">firstName</th>
			<th style="text-align:center">lastName</th>
			<th style="text-align:center">birthDate</th>
			<th style="text-align:center">Relationship</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dependents.each do |dependent| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dependent.firstName %>
			</td>
			<td style="text-align:center">
	  			<%= dependent.lastName %>
			</td>
			<td style="text-align:center">
	  			<%= dependent.birthDate %>
			</td>
			<td style="text-align:center">
	  			<%= dependent.Relationship %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dependent_path(dependent), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dependent_path(dependent), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Dependent', new_dependent_path, :method => :get, :class => "btn btn-success btn-sm" %>