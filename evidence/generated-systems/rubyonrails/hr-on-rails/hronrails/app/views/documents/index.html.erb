<div class="title text-center">
  List of Documents
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">fileUrl</th>
			<th style="text-align:center">uploadedDate</th>
			<th style="text-align:center">DocumentType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @documents.each do |document| %>
		<tr>   
			<td style="text-align:center">
	  			<%= document.name %>
			</td>
			<td style="text-align:center">
	  			<%= document.fileUrl %>
			</td>
			<td style="text-align:center">
	  			<%= document.uploadedDate %>
			</td>
			<td style="text-align:center">
	  			<%= document.DocumentType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_document_path(document), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', document_path(document), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Document', new_document_path, :method => :get, :class => "btn btn-success btn-sm" %>