<div class="title text-center">
  List of Employees
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">employeeNumber</th>
			<th style="text-align:center">name</th>
			<th style="text-align:center">workEmail</th>
			<th style="text-align:center">workPhone</th>
			<th style="text-align:center">dateOfHire</th>
			<th style="text-align:center">nationalId</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @employees.each do |employee| %>
		<tr>   
			<td style="text-align:center">
	  			<%= employee.employeeNumber %>
			</td>
			<td style="text-align:center">
	  			<%= employee.name %>
			</td>
			<td style="text-align:center">
	  			<%= employee.workEmail %>
			</td>
			<td style="text-align:center">
	  			<%= employee.workPhone %>
			</td>
			<td style="text-align:center">
	  			<%= employee.dateOfHire %>
			</td>
			<td style="text-align:center">
	  			<%= employee.nationalId %>
			</td>
			<td style="text-align:center">
	  			<%= employee.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_employee_path(employee), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', employee_path(employee), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Employee', new_employee_path, :method => :get, :class => "btn btn-success btn-sm" %>