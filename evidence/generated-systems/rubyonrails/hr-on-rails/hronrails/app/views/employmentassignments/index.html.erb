<div class="title text-center">
  List of EmploymentAssignments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">startDate</th>
			<th style="text-align:center">endDate</th>
			<th style="text-align:center">primary</th>
			<th style="text-align:center">AssignmentType</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @employmentAssignments.each do |employmentAssignment| %>
		<tr>   
			<td style="text-align:center">
	  			<%= employmentAssignment.startDate %>
			</td>
			<td style="text-align:center">
	  			<%= employmentAssignment.endDate %>
			</td>
			<td style="text-align:center">
	  			<%= employmentAssignment.primary %>
			</td>
			<td style="text-align:center">
	  			<%= employmentAssignment.AssignmentType %>
			</td>
			<td style="text-align:center">
	  			<%= employmentAssignment.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_employmentAssignment_path(employmentAssignment), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', employmentAssignment_path(employmentAssignment), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New EmploymentAssignment', new_employmentAssignment_path, :method => :get, :class => "btn btn-success btn-sm" %>