<div class="title text-center">
  List of EquityGrants
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">grantId</th>
			<th style="text-align:center">grantedUnits</th>
			<th style="text-align:center">vestingStart</th>
			<th style="text-align:center">GrantType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @equityGrants.each do |equityGrant| %>
		<tr>   
			<td style="text-align:center">
	  			<%= equityGrant.grantId %>
			</td>
			<td style="text-align:center">
	  			<%= equityGrant.grantedUnits %>
			</td>
			<td style="text-align:center">
	  			<%= equityGrant.vestingStart %>
			</td>
			<td style="text-align:center">
	  			<%= equityGrant.GrantType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_equityGrant_path(equityGrant), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', equityGrant_path(equityGrant), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New EquityGrant', new_equityGrant_path, :method => :get, :class => "btn btn-success btn-sm" %>