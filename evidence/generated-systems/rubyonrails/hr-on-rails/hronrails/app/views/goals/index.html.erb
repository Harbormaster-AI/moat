<div class="title text-center">
  List of Goals
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">title</th>
			<th style="text-align:center">description</th>
			<th style="text-align:center">targetDate</th>
			<th style="text-align:center">weight</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @goals.each do |goal| %>
		<tr>   
			<td style="text-align:center">
	  			<%= goal.title %>
			</td>
			<td style="text-align:center">
	  			<%= goal.description %>
			</td>
			<td style="text-align:center">
	  			<%= goal.targetDate %>
			</td>
			<td style="text-align:center">
	  			<%= goal.weight %>
			</td>
			<td style="text-align:center">
	  			<%= goal.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_goal_path(goal), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', goal_path(goal), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Goal', new_goal_path, :method => :get, :class => "btn btn-success btn-sm" %>