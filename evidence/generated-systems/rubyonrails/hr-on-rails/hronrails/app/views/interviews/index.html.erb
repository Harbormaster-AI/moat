<div class="title text-center">
  List of Interviews
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">interviewDate</th>
			<th style="text-align:center">feedback</th>
			<th style="text-align:center">Stage</th>
			<th style="text-align:center">Result</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @interviews.each do |interview| %>
		<tr>   
			<td style="text-align:center">
	  			<%= interview.interviewDate %>
			</td>
			<td style="text-align:center">
	  			<%= interview.feedback %>
			</td>
			<td style="text-align:center">
	  			<%= interview.Stage %>
			</td>
			<td style="text-align:center">
	  			<%= interview.Result %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_interview_path(interview), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', interview_path(interview), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Interview', new_interview_path, :method => :get, :class => "btn btn-success btn-sm" %>