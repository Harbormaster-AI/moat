<div class="title text-center">
  List of JobApplications
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">applicationNumber</th>
			<th style="text-align:center">appliedDate</th>
			<th style="text-align:center">resumeUrl</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @jobApplications.each do |jobApplication| %>
		<tr>   
			<td style="text-align:center">
	  			<%= jobApplication.applicationNumber %>
			</td>
			<td style="text-align:center">
	  			<%= jobApplication.appliedDate %>
			</td>
			<td style="text-align:center">
	  			<%= jobApplication.resumeUrl %>
			</td>
			<td style="text-align:center">
	  			<%= jobApplication.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_jobApplication_path(jobApplication), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', jobApplication_path(jobApplication), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New JobApplication', new_jobApplication_path, :method => :get, :class => "btn btn-success btn-sm" %>