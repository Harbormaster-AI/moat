<div class="title text-center">
  List of LeaveRequests
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">requestNumber</th>
			<th style="text-align:center">startDate</th>
			<th style="text-align:center">endDate</th>
			<th style="text-align:center">reason</th>
			<th style="text-align:center">hours</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @leaveRequests.each do |leaveRequest| %>
		<tr>   
			<td style="text-align:center">
	  			<%= leaveRequest.requestNumber %>
			</td>
			<td style="text-align:center">
	  			<%= leaveRequest.startDate %>
			</td>
			<td style="text-align:center">
	  			<%= leaveRequest.endDate %>
			</td>
			<td style="text-align:center">
	  			<%= leaveRequest.reason %>
			</td>
			<td style="text-align:center">
	  			<%= leaveRequest.hours %>
			</td>
			<td style="text-align:center">
	  			<%= leaveRequest.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_leaveRequest_path(leaveRequest), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', leaveRequest_path(leaveRequest), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New LeaveRequest', new_leaveRequest_path, :method => :get, :class => "btn btn-success btn-sm" %>