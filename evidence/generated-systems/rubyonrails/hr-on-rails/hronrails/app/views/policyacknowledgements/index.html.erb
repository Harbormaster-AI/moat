<div class="title text-center">
  List of PolicyAcknowledgements
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">acknowledgementDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @policyAcknowledgements.each do |policyAcknowledgement| %>
		<tr>   
			<td style="text-align:center">
	  			<%= policyAcknowledgement.acknowledgementDate %>
			</td>
			<td style="text-align:center">
	  			<%= policyAcknowledgement.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_policyAcknowledgement_path(policyAcknowledgement), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', policyAcknowledgement_path(policyAcknowledgement), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PolicyAcknowledgement', new_policyAcknowledgement_path, :method => :get, :class => "btn btn-success btn-sm" %>