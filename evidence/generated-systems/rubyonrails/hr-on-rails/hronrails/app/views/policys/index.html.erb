<div class="title text-center">
  List of Policys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">policyNumber</th>
			<th style="text-align:center">name</th>
			<th style="text-align:center">effectiveDate</th>
			<th style="text-align:center">description</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @policys.each do |policy| %>
		<tr>   
			<td style="text-align:center">
	  			<%= policy.policyNumber %>
			</td>
			<td style="text-align:center">
	  			<%= policy.name %>
			</td>
			<td style="text-align:center">
	  			<%= policy.effectiveDate %>
			</td>
			<td style="text-align:center">
	  			<%= policy.description %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_policy_path(policy), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', policy_path(policy), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Policy', new_policy_path, :method => :get, :class => "btn btn-success btn-sm" %>