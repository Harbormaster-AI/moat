<div class="title text-center">
  List of TaxWithholdings
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">taxId</th>
			<th style="text-align:center">allowances</th>
			<th style="text-align:center">additionalAmount</th>
			<th style="text-align:center">FilingStatus</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @taxWithholdings.each do |taxWithholding| %>
		<tr>   
			<td style="text-align:center">
	  			<%= taxWithholding.taxId %>
			</td>
			<td style="text-align:center">
	  			<%= taxWithholding.allowances %>
			</td>
			<td style="text-align:center">
	  			<%= taxWithholding.additionalAmount %>
			</td>
			<td style="text-align:center">
	  			<%= taxWithholding.FilingStatus %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_taxWithholding_path(taxWithholding), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', taxWithholding_path(taxWithholding), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TaxWithholding', new_taxWithholding_path, :method => :get, :class => "btn btn-success btn-sm" %>