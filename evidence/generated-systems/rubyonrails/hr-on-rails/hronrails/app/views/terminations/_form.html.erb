<%= form_with model: @termination, local: true do |form| %>
 
  <% if @termination.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@termination.errors.count, "error") %> prohibited
        this termination from being saved:
      </h2>
      <ul>
        <% @termination.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="card">
    <div class="card-body">

  <p>
    <%= form.label :terminationNumber, { class: 'form-label'} %><br>
	<%= form.text_field :terminationNumber, { class: 'form-label'} %>
  </p>			
  <p>
    <%= form.label :terminationDate, { class: 'form-label'} %><br>
    <%= form.date_field :terminationDate, { class: 'form-label'} %>
  </p>			
  <p>
    <%= form.label :notes, { class: 'form-label'} %><br>
	<%= form.text_field :notes, { class: 'form-label'} %>
  </p>			
  <p>
    <%= form.check_box :eligibleForRehire, {class: "form-check-input"} %>
    <%= form.label :eligibleForRehire, { class: 'form-label'} %><br>	
  </p>			
  <p>
  </p>			
  <p>
  </p>			
  <p>
   <%= form.label :Reason, { class: 'form-label'} %><br>
   <%= form.select :Reason, Termination.Reasons.keys, { class: 'form-control'} %>
  </p>			
  <p>
   <%= form.label :Type, { class: 'form-label'} %><br>
   <%= form.select :Type, Termination.Types.keys, { class: 'form-control'} %>
  </p>			

      <%= form.submit %>
    
    </div>
  
  </div> 
<% end %>