<div class="title text-center">
  List of Timesheets
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">periodStart</th>
			<th style="text-align:center">periodEnd</th>
			<th style="text-align:center">submissionDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @timesheets.each do |timesheet| %>
		<tr>   
			<td style="text-align:center">
	  			<%= timesheet.periodStart %>
			</td>
			<td style="text-align:center">
	  			<%= timesheet.periodEnd %>
			</td>
			<td style="text-align:center">
	  			<%= timesheet.submissionDate %>
			</td>
			<td style="text-align:center">
	  			<%= timesheet.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_timesheet_path(timesheet), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', timesheet_path(timesheet), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Timesheet', new_timesheet_path, :method => :get, :class => "btn btn-success btn-sm" %>