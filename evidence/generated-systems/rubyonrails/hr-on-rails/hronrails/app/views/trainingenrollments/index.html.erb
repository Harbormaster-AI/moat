<div class="title text-center">
  List of TrainingEnrollments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">enrollmentNumber</th>
			<th style="text-align:center">completionDate</th>
			<th style="text-align:center">score</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @trainingEnrollments.each do |trainingEnrollment| %>
		<tr>   
			<td style="text-align:center">
	  			<%= trainingEnrollment.enrollmentNumber %>
			</td>
			<td style="text-align:center">
	  			<%= trainingEnrollment.completionDate %>
			</td>
			<td style="text-align:center">
	  			<%= trainingEnrollment.score %>
			</td>
			<td style="text-align:center">
	  			<%= trainingEnrollment.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_trainingEnrollment_path(trainingEnrollment), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', trainingEnrollment_path(trainingEnrollment), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TrainingEnrollment', new_trainingEnrollment_path, :method => :get, :class => "btn btn-success btn-sm" %>