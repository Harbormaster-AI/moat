<div class="title text-center">
  List of WorkAuthorizations
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">country</th>
			<th style="text-align:center">expirationDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @workAuthorizations.each do |workAuthorization| %>
		<tr>   
			<td style="text-align:center">
	  			<%= workAuthorization.country %>
			</td>
			<td style="text-align:center">
	  			<%= workAuthorization.expirationDate %>
			</td>
			<td style="text-align:center">
	  			<%= workAuthorization.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_workAuthorization_path(workAuthorization), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', workAuthorization_path(workAuthorization), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New WorkAuthorization', new_workAuthorization_path, :method => :get, :class => "btn btn-success btn-sm" %>