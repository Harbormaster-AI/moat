<div class="title text-center">
  List of WorkShifts
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">startTime</th>
			<th style="text-align:center">endTime</th>
			<th style="text-align:center">breakMinutes</th>
			<th style="text-align:center">DayOfWeek</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @workShifts.each do |workShift| %>
		<tr>   
			<td style="text-align:center">
	  			<%= workShift.startTime %>
			</td>
			<td style="text-align:center">
	  			<%= workShift.endTime %>
			</td>
			<td style="text-align:center">
	  			<%= workShift.breakMinutes %>
			</td>
			<td style="text-align:center">
	  			<%= workShift.DayOfWeek %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_workShift_path(workShift), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', workShift_path(workShift), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New WorkShift', new_workShift_path, :method => :get, :class => "btn btn-success btn-sm" %>