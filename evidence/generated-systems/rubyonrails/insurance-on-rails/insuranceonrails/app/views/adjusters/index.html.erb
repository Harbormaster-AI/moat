<div class="title text-center">
  List of Adjusters
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">firstName</th>
			<th style="text-align:center">lastName</th>
			<th style="text-align:center">licenseNumber</th>
			<th style="text-align:center">AdjusterType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @adjusters.each do |adjuster| %>
		<tr>   
			<td style="text-align:center">
	  			<%= adjuster.firstName %>
			</td>
			<td style="text-align:center">
	  			<%= adjuster.lastName %>
			</td>
			<td style="text-align:center">
	  			<%= adjuster.licenseNumber %>
			</td>
			<td style="text-align:center">
	  			<%= adjuster.AdjusterType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_adjuster_path(adjuster), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', adjuster_path(adjuster), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Adjuster', new_adjuster_path, :method => :get, :class => "btn btn-success btn-sm" %>