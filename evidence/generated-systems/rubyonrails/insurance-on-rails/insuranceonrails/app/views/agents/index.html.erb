<div class="title text-center">
  List of Agents
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">firstName</th>
			<th style="text-align:center">lastName</th>
			<th style="text-align:center">licenseId</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @agents.each do |agent| %>
		<tr>   
			<td style="text-align:center">
	  			<%= agent.firstName %>
			</td>
			<td style="text-align:center">
	  			<%= agent.lastName %>
			</td>
			<td style="text-align:center">
	  			<%= agent.licenseId %>
			</td>
			<td style="text-align:center">
	  			<%= agent.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_agent_path(agent), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', agent_path(agent), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Agent', new_agent_path, :method => :get, :class => "btn btn-success btn-sm" %>