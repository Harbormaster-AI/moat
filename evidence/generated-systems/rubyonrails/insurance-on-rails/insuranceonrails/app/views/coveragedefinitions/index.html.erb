<div class="title text-center">
  List of CoverageDefinitions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">defaultLimit</th>
			<th style="text-align:center">defaultDeductible</th>
			<th style="text-align:center">asMandatory</th>
			<th style="text-align:center">CoverageType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @coverageDefinitions.each do |coverageDefinition| %>
		<tr>   
			<td style="text-align:center">
	  			<%= coverageDefinition.name %>
			</td>
			<td style="text-align:center">
	  			<%= coverageDefinition.defaultLimit %>
			</td>
			<td style="text-align:center">
	  			<%= coverageDefinition.defaultDeductible %>
			</td>
			<td style="text-align:center">
	  			<%= coverageDefinition.asMandatory %>
			</td>
			<td style="text-align:center">
	  			<%= coverageDefinition.CoverageType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_coverageDefinition_path(coverageDefinition), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', coverageDefinition_path(coverageDefinition), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CoverageDefinition', new_coverageDefinition_path, :method => :get, :class => "btn btn-success btn-sm" %>