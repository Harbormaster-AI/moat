<div class="title text-center">
  List of Distributors
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">licenseNumber</th>
			<th style="text-align:center">region</th>
			<th style="text-align:center">DistributorType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @distributors.each do |distributor| %>
		<tr>   
			<td style="text-align:center">
	  			<%= distributor.name %>
			</td>
			<td style="text-align:center">
	  			<%= distributor.licenseNumber %>
			</td>
			<td style="text-align:center">
	  			<%= distributor.region %>
			</td>
			<td style="text-align:center">
	  			<%= distributor.DistributorType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_distributor_path(distributor), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', distributor_path(distributor), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Distributor', new_distributor_path, :method => :get, :class => "btn btn-success btn-sm" %>