<div class="title text-center">
  List of Incidents
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">location</th>
			<th style="text-align:center">description</th>
			<th style="text-align:center">IncidentType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @incidents.each do |incident| %>
		<tr>   
			<td style="text-align:center">
	  			<%= incident.location %>
			</td>
			<td style="text-align:center">
	  			<%= incident.description %>
			</td>
			<td style="text-align:center">
	  			<%= incident.IncidentType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_incident_path(incident), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', incident_path(incident), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Incident', new_incident_path, :method => :get, :class => "btn btn-success btn-sm" %>