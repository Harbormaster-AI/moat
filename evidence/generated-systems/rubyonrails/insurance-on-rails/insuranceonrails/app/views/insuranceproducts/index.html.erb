<div class="title text-center">
  List of InsuranceProducts
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">productCode</th>
			<th style="text-align:center">LineOfBusiness</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @insuranceProducts.each do |insuranceProduct| %>
		<tr>   
			<td style="text-align:center">
	  			<%= insuranceProduct.name %>
			</td>
			<td style="text-align:center">
	  			<%= insuranceProduct.productCode %>
			</td>
			<td style="text-align:center">
	  			<%= insuranceProduct.LineOfBusiness %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_insuranceProduct_path(insuranceProduct), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', insuranceProduct_path(insuranceProduct), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InsuranceProduct', new_insuranceProduct_path, :method => :get, :class => "btn btn-success btn-sm" %>