<div class="title text-center">
  List of InsuredObjects
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">description</th>
			<th style="text-align:center">serialOrId</th>
			<th style="text-align:center">primaryAddress</th>
			<th style="text-align:center">ObjectType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @insuredObjects.each do |insuredObject| %>
		<tr>   
			<td style="text-align:center">
	  			<%= insuredObject.description %>
			</td>
			<td style="text-align:center">
	  			<%= insuredObject.serialOrId %>
			</td>
			<td style="text-align:center">
	  			<%= insuredObject.primaryAddress %>
			</td>
			<td style="text-align:center">
	  			<%= insuredObject.ObjectType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_insuredObject_path(insuredObject), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', insuredObject_path(insuredObject), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InsuredObject', new_insuredObject_path, :method => :get, :class => "btn btn-success btn-sm" %>