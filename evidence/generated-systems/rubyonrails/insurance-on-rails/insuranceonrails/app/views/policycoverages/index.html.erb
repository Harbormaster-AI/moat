<div class="title text-center">
  List of PolicyCoverages
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">limit</th>
			<th style="text-align:center">deductible</th>
			<th style="text-align:center">premium</th>
			<th style="text-align:center">CoverageType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @policyCoverages.each do |policyCoverage| %>
		<tr>   
			<td style="text-align:center">
	  			<%= policyCoverage.limit %>
			</td>
			<td style="text-align:center">
	  			<%= policyCoverage.deductible %>
			</td>
			<td style="text-align:center">
	  			<%= policyCoverage.premium %>
			</td>
			<td style="text-align:center">
	  			<%= policyCoverage.CoverageType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_policyCoverage_path(policyCoverage), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', policyCoverage_path(policyCoverage), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PolicyCoverage', new_policyCoverage_path, :method => :get, :class => "btn btn-success btn-sm" %>