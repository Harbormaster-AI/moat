<div class="title text-center">
  List of ServiceProviders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">taxId</th>
			<th style="text-align:center">ProviderType</th>
			<th style="text-align:center">NetworkStatus</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @serviceProviders.each do |serviceProvider| %>
		<tr>   
			<td style="text-align:center">
	  			<%= serviceProvider.name %>
			</td>
			<td style="text-align:center">
	  			<%= serviceProvider.taxId %>
			</td>
			<td style="text-align:center">
	  			<%= serviceProvider.ProviderType %>
			</td>
			<td style="text-align:center">
	  			<%= serviceProvider.NetworkStatus %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_serviceProvider_path(serviceProvider), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', serviceProvider_path(serviceProvider), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ServiceProvider', new_serviceProvider_path, :method => :get, :class => "btn btn-success btn-sm" %>