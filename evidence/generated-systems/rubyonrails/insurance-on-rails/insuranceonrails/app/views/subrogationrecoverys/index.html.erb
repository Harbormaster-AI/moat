<div class="title text-center">
  List of SubrogationRecoverys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">recoveryReference</th>
			<th style="text-align:center">amount</th>
			<th style="text-align:center">recoveryDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @subrogationRecoverys.each do |subrogationRecovery| %>
		<tr>   
			<td style="text-align:center">
	  			<%= subrogationRecovery.recoveryReference %>
			</td>
			<td style="text-align:center">
	  			<%= subrogationRecovery.amount %>
			</td>
			<td style="text-align:center">
	  			<%= subrogationRecovery.recoveryDate %>
			</td>
			<td style="text-align:center">
	  			<%= subrogationRecovery.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_subrogationRecovery_path(subrogationRecovery), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', subrogationRecovery_path(subrogationRecovery), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New SubrogationRecovery', new_subrogationRecovery_path, :method => :get, :class => "btn btn-success btn-sm" %>