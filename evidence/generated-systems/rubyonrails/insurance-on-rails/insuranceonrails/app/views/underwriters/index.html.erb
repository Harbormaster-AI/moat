<div class="title text-center">
  List of Underwriters
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">firstName</th>
			<th style="text-align:center">lastName</th>
			<th style="text-align:center">employeeId</th>
			<th style="text-align:center">authorityLimit</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @underwriters.each do |underwriter| %>
		<tr>   
			<td style="text-align:center">
	  			<%= underwriter.firstName %>
			</td>
			<td style="text-align:center">
	  			<%= underwriter.lastName %>
			</td>
			<td style="text-align:center">
	  			<%= underwriter.employeeId %>
			</td>
			<td style="text-align:center">
	  			<%= underwriter.authorityLimit %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_underwriter_path(underwriter), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', underwriter_path(underwriter), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Underwriter', new_underwriter_path, :method => :get, :class => "btn btn-success btn-sm" %>