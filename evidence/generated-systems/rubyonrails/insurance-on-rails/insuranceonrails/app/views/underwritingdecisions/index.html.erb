<div class="title text-center">
  List of UnderwritingDecisions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">notes</th>
			<th style="text-align:center">decisionDate</th>
			<th style="text-align:center">Decision</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @underwritingDecisions.each do |underwritingDecision| %>
		<tr>   
			<td style="text-align:center">
	  			<%= underwritingDecision.notes %>
			</td>
			<td style="text-align:center">
	  			<%= underwritingDecision.decisionDate %>
			</td>
			<td style="text-align:center">
	  			<%= underwritingDecision.Decision %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_underwritingDecision_path(underwritingDecision), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', underwritingDecision_path(underwritingDecision), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New UnderwritingDecision', new_underwritingDecision_path, :method => :get, :class => "btn btn-success btn-sm" %>