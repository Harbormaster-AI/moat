<div class="title text-center">
  List of DemandSignals
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">externalReference</th>
			<th style="text-align:center">requestedDate</th>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">DemandType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @demandSignals.each do |demandSignal| %>
		<tr>   
			<td style="text-align:center">
	  			<%= demandSignal.externalReference %>
			</td>
			<td style="text-align:center">
	  			<%= demandSignal.requestedDate %>
			</td>
			<td style="text-align:center">
	  			<%= demandSignal.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= demandSignal.DemandType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_demandSignal_path(demandSignal), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', demandSignal_path(demandSignal), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DemandSignal', new_demandSignal_path, :method => :get, :class => "btn btn-success btn-sm" %>