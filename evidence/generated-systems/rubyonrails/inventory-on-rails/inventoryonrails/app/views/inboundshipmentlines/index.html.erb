<div class="title text-center">
  List of InboundShipmentLines
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">lineNumber</th>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">UnitOfMeasure</th>
			<th style="text-align:center">StockStatus</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @inboundShipmentLines.each do |inboundShipmentLine| %>
		<tr>   
			<td style="text-align:center">
	  			<%= inboundShipmentLine.lineNumber %>
			</td>
			<td style="text-align:center">
	  			<%= inboundShipmentLine.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= inboundShipmentLine.UnitOfMeasure %>
			</td>
			<td style="text-align:center">
	  			<%= inboundShipmentLine.StockStatus %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_inboundShipmentLine_path(inboundShipmentLine), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', inboundShipmentLine_path(inboundShipmentLine), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InboundShipmentLine', new_inboundShipmentLine_path, :method => :get, :class => "btn btn-success btn-sm" %>