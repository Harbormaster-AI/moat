<div class="title text-center">
  List of InboundShipments
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">shipmentNumber</th>
			<th style="text-align:center">expectedArrivalDate</th>
			<th style="text-align:center">arrivalDate</th>
			<th style="text-align:center">carrierName</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @inboundShipments.each do |inboundShipment| %>
		<tr>   
			<td style="text-align:center">
	  			<%= inboundShipment.shipmentNumber %>
			</td>
			<td style="text-align:center">
	  			<%= inboundShipment.expectedArrivalDate %>
			</td>
			<td style="text-align:center">
	  			<%= inboundShipment.arrivalDate %>
			</td>
			<td style="text-align:center">
	  			<%= inboundShipment.carrierName %>
			</td>
			<td style="text-align:center">
	  			<%= inboundShipment.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_inboundShipment_path(inboundShipment), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', inboundShipment_path(inboundShipment), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InboundShipment', new_inboundShipment_path, :method => :get, :class => "btn btn-success btn-sm" %>