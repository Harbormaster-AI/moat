<div class="title text-center">
  List of Lots
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">batchNumber</th>
			<th style="text-align:center">manufactureDate</th>
			<th style="text-align:center">expirationDate</th>
			<th style="text-align:center">LotStatus</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @lots.each do |lot| %>
		<tr>   
			<td style="text-align:center">
	  			<%= lot.batchNumber %>
			</td>
			<td style="text-align:center">
	  			<%= lot.manufactureDate %>
			</td>
			<td style="text-align:center">
	  			<%= lot.expirationDate %>
			</td>
			<td style="text-align:center">
	  			<%= lot.LotStatus %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_lot_path(lot), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', lot_path(lot), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Lot', new_lot_path, :method => :get, :class => "btn btn-success btn-sm" %>