<div class="title text-center">
  List of OutboundAllocations
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">allocationNumber</th>
			<th style="text-align:center">allocatedQuantity</th>
			<th style="text-align:center">allocationDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @outboundAllocations.each do |outboundAllocation| %>
		<tr>   
			<td style="text-align:center">
	  			<%= outboundAllocation.allocationNumber %>
			</td>
			<td style="text-align:center">
	  			<%= outboundAllocation.allocatedQuantity %>
			</td>
			<td style="text-align:center">
	  			<%= outboundAllocation.allocationDate %>
			</td>
			<td style="text-align:center">
	  			<%= outboundAllocation.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_outboundAllocation_path(outboundAllocation), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', outboundAllocation_path(outboundAllocation), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New OutboundAllocation', new_outboundAllocation_path, :method => :get, :class => "btn btn-success btn-sm" %>