<div class="title text-center">
  List of SerialNumbers
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">serial</th>
			<th style="text-align:center">activationDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @serialNumbers.each do |serialNumber| %>
		<tr>   
			<td style="text-align:center">
	  			<%= serialNumber.serial %>
			</td>
			<td style="text-align:center">
	  			<%= serialNumber.activationDate %>
			</td>
			<td style="text-align:center">
	  			<%= serialNumber.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_serialNumber_path(serialNumber), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', serialNumber_path(serialNumber), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New SerialNumber', new_serialNumber_path, :method => :get, :class => "btn btn-success btn-sm" %>