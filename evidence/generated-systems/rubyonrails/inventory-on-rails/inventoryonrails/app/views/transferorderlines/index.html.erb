<div class="title text-center">
  List of TransferOrderLines
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">lineNumber</th>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">UnitOfMeasure</th>
			<th style="text-align:center">StockStatus</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @transferOrderLines.each do |transferOrderLine| %>
		<tr>   
			<td style="text-align:center">
	  			<%= transferOrderLine.lineNumber %>
			</td>
			<td style="text-align:center">
	  			<%= transferOrderLine.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= transferOrderLine.UnitOfMeasure %>
			</td>
			<td style="text-align:center">
	  			<%= transferOrderLine.StockStatus %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_transferOrderLine_path(transferOrderLine), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', transferOrderLine_path(transferOrderLine), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TransferOrderLine', new_transferOrderLine_path, :method => :get, :class => "btn btn-success btn-sm" %>