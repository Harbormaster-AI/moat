<div class="title text-center">
  List of TransferOrders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">orderNumber</th>
			<th style="text-align:center">requestedShipDate</th>
			<th style="text-align:center">requestedReceiveDate</th>
			<th style="text-align:center">shippedDate</th>
			<th style="text-align:center">receivedDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @transferOrders.each do |transferOrder| %>
		<tr>   
			<td style="text-align:center">
	  			<%= transferOrder.orderNumber %>
			</td>
			<td style="text-align:center">
	  			<%= transferOrder.requestedShipDate %>
			</td>
			<td style="text-align:center">
	  			<%= transferOrder.requestedReceiveDate %>
			</td>
			<td style="text-align:center">
	  			<%= transferOrder.shippedDate %>
			</td>
			<td style="text-align:center">
	  			<%= transferOrder.receivedDate %>
			</td>
			<td style="text-align:center">
	  			<%= transferOrder.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_transferOrder_path(transferOrder), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', transferOrder_path(transferOrder), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TransferOrder', new_transferOrder_path, :method => :get, :class => "btn btn-success btn-sm" %>