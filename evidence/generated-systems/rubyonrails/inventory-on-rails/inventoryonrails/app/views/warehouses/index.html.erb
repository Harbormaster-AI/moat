<div class="title text-center">
  List of Warehouses
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">code</th>
			<th style="text-align:center">address</th>
			<th style="text-align:center">timeZone</th>
			<th style="text-align:center">allowsOverAllocation</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @warehouses.each do |warehouse| %>
		<tr>   
			<td style="text-align:center">
	  			<%= warehouse.name %>
			</td>
			<td style="text-align:center">
	  			<%= warehouse.code %>
			</td>
			<td style="text-align:center">
	  			<%= warehouse.address %>
			</td>
			<td style="text-align:center">
	  			<%= warehouse.timeZone %>
			</td>
			<td style="text-align:center">
	  			<%= warehouse.allowsOverAllocation %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_warehouse_path(warehouse), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', warehouse_path(warehouse), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Warehouse', new_warehouse_path, :method => :get, :class => "btn btn-success btn-sm" %>