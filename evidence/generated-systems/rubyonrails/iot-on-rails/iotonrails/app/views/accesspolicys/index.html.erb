<div class="title text-center">
  List of AccessPolicys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">scope</th>
			<th style="text-align:center">expiresAt</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @accessPolicys.each do |accessPolicy| %>
		<tr>   
			<td style="text-align:center">
	  			<%= accessPolicy.name %>
			</td>
			<td style="text-align:center">
	  			<%= accessPolicy.scope %>
			</td>
			<td style="text-align:center">
	  			<%= accessPolicy.expiresAt %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_accessPolicy_path(accessPolicy), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', accessPolicy_path(accessPolicy), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New AccessPolicy', new_accessPolicy_path, :method => :get, :class => "btn btn-success btn-sm" %>