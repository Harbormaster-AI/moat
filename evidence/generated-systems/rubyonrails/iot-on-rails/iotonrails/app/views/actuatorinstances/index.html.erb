<div class="title text-center">
  List of ActuatorInstances
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">commandTopic</th>
			<th style="text-align:center">ActuatorType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @actuatorInstances.each do |actuatorInstance| %>
		<tr>   
			<td style="text-align:center">
	  			<%= actuatorInstance.name %>
			</td>
			<td style="text-align:center">
	  			<%= actuatorInstance.commandTopic %>
			</td>
			<td style="text-align:center">
	  			<%= actuatorInstance.ActuatorType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_actuatorInstance_path(actuatorInstance), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', actuatorInstance_path(actuatorInstance), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ActuatorInstance', new_actuatorInstance_path, :method => :get, :class => "btn btn-success btn-sm" %>