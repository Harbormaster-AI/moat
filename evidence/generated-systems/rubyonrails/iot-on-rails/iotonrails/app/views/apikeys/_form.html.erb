
<%= form_with model: @apiKey, local: true do |form| %>
 
  <% if @apiKey.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@apiKey.errors.count, "error") %> prohibited
        this apiKey from being saved:
      </h2>
      <ul>
        <% @apiKey.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="card">
    <div class="card-body">

  <p>
    <%= form.label :keyId, { class: 'form-label'} %><br>
	<%= form.text_field :keyId, { class: 'form-label'} %>
  </p>			
