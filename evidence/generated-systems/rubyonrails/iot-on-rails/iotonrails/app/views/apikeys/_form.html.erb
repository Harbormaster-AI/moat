    <%= form.label :hashedSecret, { class: 'form-label'} %><br>
	<%= form.text_field :hashedSecret, { class: 'form-label'} %>
  </p>			
  <p>
    <%= form.label :createdAt, { class: 'form-label'} %><br>
    <%= form.time_field :createdAt, { class: 'form-label'} %>
  </p>			
  <p>
    <%= form.label :lastUsedAt, { class: 'form-label'} %><br>
    <%= form.time_field :lastUsedAt, { class: 'form-label'} %>
  </p>			
  <p>
  </p>			

      <%= form.submit %>
    
    </div>
  
  </div> 
<% end %>