<div class="title text-center">
  List of CommandDefinitions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">requestSchemaUri</th>
			<th style="text-align:center">responseSchemaUri</th>
			<th style="text-align:center">timeoutSeconds</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @commandDefinitions.each do |commandDefinition| %>
		<tr>   
			<td style="text-align:center">
	  			<%= commandDefinition.name %>
			</td>
			<td style="text-align:center">
	  			<%= commandDefinition.requestSchemaUri %>
			</td>
			<td style="text-align:center">
	  			<%= commandDefinition.responseSchemaUri %>
			</td>
			<td style="text-align:center">
	  			<%= commandDefinition.timeoutSeconds %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_commandDefinition_path(commandDefinition), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', commandDefinition_path(commandDefinition), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CommandDefinition', new_commandDefinition_path, :method => :get, :class => "btn btn-success btn-sm" %>