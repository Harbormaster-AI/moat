<div class="title text-center">
  List of CommandInvocations
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">invocationId</th>
			<th style="text-align:center">requestedAt</th>
			<th style="text-align:center">completedAt</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @commandInvocations.each do |commandInvocation| %>
		<tr>   
			<td style="text-align:center">
	  			<%= commandInvocation.invocationId %>
			</td>
			<td style="text-align:center">
	  			<%= commandInvocation.requestedAt %>
			</td>
			<td style="text-align:center">
	  			<%= commandInvocation.completedAt %>
			</td>
			<td style="text-align:center">
	  			<%= commandInvocation.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_commandInvocation_path(commandInvocation), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', commandInvocation_path(commandInvocation), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CommandInvocation', new_commandInvocation_path, :method => :get, :class => "btn btn-success btn-sm" %>