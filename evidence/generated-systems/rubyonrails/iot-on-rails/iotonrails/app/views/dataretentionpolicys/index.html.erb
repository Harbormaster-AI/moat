<div class="title text-center">
  List of DataRetentionPolicys
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">retentionDays</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @dataRetentionPolicys.each do |dataRetentionPolicy| %>
		<tr>   
			<td style="text-align:center">
	  			<%= dataRetentionPolicy.name %>
			</td>
			<td style="text-align:center">
	  			<%= dataRetentionPolicy.retentionDays %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_dataRetentionPolicy_path(dataRetentionPolicy), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', dataRetentionPolicy_path(dataRetentionPolicy), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DataRetentionPolicy', new_dataRetentionPolicy_path, :method => :get, :class => "btn btn-success btn-sm" %>