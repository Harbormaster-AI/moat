<div class="title text-center">
  List of DeviceCertificates
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">serialNumber</th>
			<th style="text-align:center">notBefore</th>
			<th style="text-align:center">notAfter</th>
			<th style="text-align:center">fingerprint</th>
			<th style="text-align:center">CertificateType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @deviceCertificates.each do |deviceCertificate| %>
		<tr>   
			<td style="text-align:center">
	  			<%= deviceCertificate.serialNumber %>
			</td>
			<td style="text-align:center">
	  			<%= deviceCertificate.notBefore %>
			</td>
			<td style="text-align:center">
	  			<%= deviceCertificate.notAfter %>
			</td>
			<td style="text-align:center">
	  			<%= deviceCertificate.fingerprint %>
			</td>
			<td style="text-align:center">
	  			<%= deviceCertificate.CertificateType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_deviceCertificate_path(deviceCertificate), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', deviceCertificate_path(deviceCertificate), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DeviceCertificate', new_deviceCertificate_path, :method => :get, :class => "btn btn-success btn-sm" %>