<div class="title text-center">
  List of DeviceGroups
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">criteria</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @deviceGroups.each do |deviceGroup| %>
		<tr>   
			<td style="text-align:center">
	  			<%= deviceGroup.name %>
			</td>
			<td style="text-align:center">
	  			<%= deviceGroup.criteria %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_deviceGroup_path(deviceGroup), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', deviceGroup_path(deviceGroup), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DeviceGroup', new_deviceGroup_path, :method => :get, :class => "btn btn-success btn-sm" %>