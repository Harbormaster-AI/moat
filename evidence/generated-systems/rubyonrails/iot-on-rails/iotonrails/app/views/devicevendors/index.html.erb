<div class="title text-center">
  List of DeviceVendors
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">legalName</th>
			<th style="text-align:center">headquartersCountry</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @deviceVendors.each do |deviceVendor| %>
		<tr>   
			<td style="text-align:center">
	  			<%= deviceVendor.name %>
			</td>
			<td style="text-align:center">
	  			<%= deviceVendor.legalName %>
			</td>
			<td style="text-align:center">
	  			<%= deviceVendor.headquartersCountry %>
			</td>
			<td style="text-align:center">
	  			<%= deviceVendor.website %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_deviceVendor_path(deviceVendor), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', deviceVendor_path(deviceVendor), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New DeviceVendor', new_deviceVendor_path, :method => :get, :class => "btn btn-success btn-sm" %>