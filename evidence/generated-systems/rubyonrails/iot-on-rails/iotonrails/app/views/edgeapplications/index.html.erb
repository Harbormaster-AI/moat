<div class="title text-center">
  List of EdgeApplications
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">version</th>
			<th style="text-align:center">image</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @edgeApplications.each do |edgeApplication| %>
		<tr>   
			<td style="text-align:center">
	  			<%= edgeApplication.name %>
			</td>
			<td style="text-align:center">
	  			<%= edgeApplication.version %>
			</td>
			<td style="text-align:center">
	  			<%= edgeApplication.image %>
			</td>
			<td style="text-align:center">
	  			<%= edgeApplication.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_edgeApplication_path(edgeApplication), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', edgeApplication_path(edgeApplication), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New EdgeApplication', new_edgeApplication_path, :method => :get, :class => "btn btn-success btn-sm" %>