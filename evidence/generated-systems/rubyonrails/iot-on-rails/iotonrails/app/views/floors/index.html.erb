<div class="title text-center">
  List of Floors
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">level</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @floors.each do |floor| %>
		<tr>   
			<td style="text-align:center">
	  			<%= floor.name %>
			</td>
			<td style="text-align:center">
	  			<%= floor.level %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_floor_path(floor), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', floor_path(floor), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Floor', new_floor_path, :method => :get, :class => "btn btn-success btn-sm" %>