<div class="title text-center">
  List of MessagingEndpoints
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">host</th>
			<th style="text-align:center">port</th>
			<th style="text-align:center">secure</th>
			<th style="text-align:center">Protocol</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @messagingEndpoints.each do |messagingEndpoint| %>
		<tr>   
			<td style="text-align:center">
	  			<%= messagingEndpoint.host %>
			</td>
			<td style="text-align:center">
	  			<%= messagingEndpoint.port %>
			</td>
			<td style="text-align:center">
	  			<%= messagingEndpoint.secure %>
			</td>
			<td style="text-align:center">
	  			<%= messagingEndpoint.Protocol %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_messagingEndpoint_path(messagingEndpoint), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', messagingEndpoint_path(messagingEndpoint), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New MessagingEndpoint', new_messagingEndpoint_path, :method => :get, :class => "btn btn-success btn-sm" %>