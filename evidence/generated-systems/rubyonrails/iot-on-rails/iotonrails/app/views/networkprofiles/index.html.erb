<div class="title text-center">
  List of NetworkProfiles
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">profileName</th>
			<th style="text-align:center">ssid</th>
			<th style="text-align:center">apn</th>
			<th style="text-align:center">ConnectivityType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @networkProfiles.each do |networkProfile| %>
		<tr>   
			<td style="text-align:center">
	  			<%= networkProfile.profileName %>
			</td>
			<td style="text-align:center">
	  			<%= networkProfile.ssid %>
			</td>
			<td style="text-align:center">
	  			<%= networkProfile.apn %>
			</td>
			<td style="text-align:center">
	  			<%= networkProfile.ConnectivityType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_networkProfile_path(networkProfile), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', networkProfile_path(networkProfile), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New NetworkProfile', new_networkProfile_path, :method => :get, :class => "btn btn-success btn-sm" %>