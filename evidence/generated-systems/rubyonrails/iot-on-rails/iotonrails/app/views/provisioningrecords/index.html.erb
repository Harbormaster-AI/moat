<div class="title text-center">
  List of ProvisioningRecords
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">enrolledAt</th>
			<th style="text-align:center">provisioningService</th>
			<th style="text-align:center">Method</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @provisioningRecords.each do |provisioningRecord| %>
		<tr>   
			<td style="text-align:center">
	  			<%= provisioningRecord.enrolledAt %>
			</td>
			<td style="text-align:center">
	  			<%= provisioningRecord.provisioningService %>
			</td>
			<td style="text-align:center">
	  			<%= provisioningRecord.Method %>
			</td>
			<td style="text-align:center">
	  			<%= provisioningRecord.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_provisioningRecord_path(provisioningRecord), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', provisioningRecord_path(provisioningRecord), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ProvisioningRecord', new_provisioningRecord_path, :method => :get, :class => "btn btn-success btn-sm" %>