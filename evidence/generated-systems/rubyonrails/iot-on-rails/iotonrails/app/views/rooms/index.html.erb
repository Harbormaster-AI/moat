<div class="title text-center">
  List of Rooms
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @rooms.each do |room| %>
		<tr>   
			<td style="text-align:center">
	  			<%= room.name %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_room_path(room), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', room_path(room), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Room', new_room_path, :method => :get, :class => "btn btn-success btn-sm" %>