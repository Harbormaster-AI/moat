<div class="title text-center">
  List of SimCards
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">iccid</th>
			<th style="text-align:center">imsi</th>
			<th style="text-align:center">carrier</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @simCards.each do |simCard| %>
		<tr>   
			<td style="text-align:center">
	  			<%= simCard.iccid %>
			</td>
			<td style="text-align:center">
	  			<%= simCard.imsi %>
			</td>
			<td style="text-align:center">
	  			<%= simCard.carrier %>
			</td>
			<td style="text-align:center">
	  			<%= simCard.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_simCard_path(simCard), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', simCard_path(simCard), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New SimCard', new_simCard_path, :method => :get, :class => "btn btn-success btn-sm" %>