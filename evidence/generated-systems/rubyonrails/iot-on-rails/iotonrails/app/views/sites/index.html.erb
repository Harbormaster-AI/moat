<div class="title text-center">
  List of Sites
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">address</th>
			<th style="text-align:center">timezone</th>
			<th style="text-align:center">latitude</th>
			<th style="text-align:center">longitude</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @sites.each do |site| %>
		<tr>   
			<td style="text-align:center">
	  			<%= site.name %>
			</td>
			<td style="text-align:center">
	  			<%= site.address %>
			</td>
			<td style="text-align:center">
	  			<%= site.timezone %>
			</td>
			<td style="text-align:center">
	  			<%= site.latitude %>
			</td>
			<td style="text-align:center">
	  			<%= site.longitude %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_site_path(site), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', site_path(site), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Site', new_site_path, :method => :get, :class => "btn btn-success btn-sm" %>