<div class="title text-center">
  List of SoftwareUpdateExecutions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">startedAt</th>
			<th style="text-align:center">completedAt</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @softwareUpdateExecutions.each do |softwareUpdateExecution| %>
		<tr>   
			<td style="text-align:center">
	  			<%= softwareUpdateExecution.startedAt %>
			</td>
			<td style="text-align:center">
	  			<%= softwareUpdateExecution.completedAt %>
			</td>
			<td style="text-align:center">
	  			<%= softwareUpdateExecution.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_softwareUpdateExecution_path(softwareUpdateExecution), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', softwareUpdateExecution_path(softwareUpdateExecution), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New SoftwareUpdateExecution', new_softwareUpdateExecution_path, :method => :get, :class => "btn btn-success btn-sm" %>