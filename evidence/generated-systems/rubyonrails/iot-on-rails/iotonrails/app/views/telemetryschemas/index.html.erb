<div class="title text-center">
  List of TelemetrySchemas
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">schemaId</th>
			<th style="text-align:center">schemaUri</th>
			<th style="text-align:center">Encoding</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @telemetrySchemas.each do |telemetrySchema| %>
		<tr>   
			<td style="text-align:center">
	  			<%= telemetrySchema.schemaId %>
			</td>
			<td style="text-align:center">
	  			<%= telemetrySchema.schemaUri %>
			</td>
			<td style="text-align:center">
	  			<%= telemetrySchema.Encoding %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_telemetrySchema_path(telemetrySchema), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', telemetrySchema_path(telemetrySchema), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TelemetrySchema', new_telemetrySchema_path, :method => :get, :class => "btn btn-success btn-sm" %>