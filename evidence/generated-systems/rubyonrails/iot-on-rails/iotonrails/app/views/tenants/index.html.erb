<div class="title text-center">
  List of Tenants
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">TenantType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @tenants.each do |tenant| %>
		<tr>   
			<td style="text-align:center">
	  			<%= tenant.name %>
			</td>
			<td style="text-align:center">
	  			<%= tenant.TenantType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_tenant_path(tenant), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', tenant_path(tenant), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Tenant', new_tenant_path, :method => :get, :class => "btn btn-success btn-sm" %>