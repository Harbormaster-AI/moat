<div class="title text-center">
  List of TwinChangeEvents
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">eventId</th>
			<th style="text-align:center">occurredAt</th>
			<th style="text-align:center">ChangeType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @twinChangeEvents.each do |twinChangeEvent| %>
		<tr>   
			<td style="text-align:center">
	  			<%= twinChangeEvent.eventId %>
			</td>
			<td style="text-align:center">
	  			<%= twinChangeEvent.occurredAt %>
			</td>
			<td style="text-align:center">
	  			<%= twinChangeEvent.ChangeType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_twinChangeEvent_path(twinChangeEvent), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', twinChangeEvent_path(twinChangeEvent), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TwinChangeEvent', new_twinChangeEvent_path, :method => :get, :class => "btn btn-success btn-sm" %>