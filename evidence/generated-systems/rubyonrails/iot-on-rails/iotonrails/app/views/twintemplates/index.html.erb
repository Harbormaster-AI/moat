<div class="title text-center">
  List of TwinTemplates
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">schemaUri</th>
			<th style="text-align:center">version</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @twinTemplates.each do |twinTemplate| %>
		<tr>   
			<td style="text-align:center">
	  			<%= twinTemplate.name %>
			</td>
			<td style="text-align:center">
	  			<%= twinTemplate.schemaUri %>
			</td>
			<td style="text-align:center">
	  			<%= twinTemplate.version %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_twinTemplate_path(twinTemplate), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', twinTemplate_path(twinTemplate), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New TwinTemplate', new_twinTemplate_path, :method => :get, :class => "btn btn-success btn-sm" %>