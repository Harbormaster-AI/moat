<div class="title text-center">
  List of UsageRecords
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">periodStart</th>
			<th style="text-align:center">periodEnd</th>
			<th style="text-align:center">messagesSent</th>
			<th style="text-align:center">dataVolumeMB</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @usageRecords.each do |usageRecord| %>
		<tr>   
			<td style="text-align:center">
	  			<%= usageRecord.periodStart %>
			</td>
			<td style="text-align:center">
	  			<%= usageRecord.periodEnd %>
			</td>
			<td style="text-align:center">
	  			<%= usageRecord.messagesSent %>
			</td>
			<td style="text-align:center">
	  			<%= usageRecord.dataVolumeMB %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_usageRecord_path(usageRecord), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', usageRecord_path(usageRecord), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New UsageRecord', new_usageRecord_path, :method => :get, :class => "btn btn-success btn-sm" %>