<div class="title text-center">
  List of BusinessUnits
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">code</th>
			<th style="text-align:center">Category</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @businessUnits.each do |businessUnit| %>
		<tr>   
			<td style="text-align:center">
	  			<%= businessUnit.name %>
			</td>
			<td style="text-align:center">
	  			<%= businessUnit.code %>
			</td>
			<td style="text-align:center">
	  			<%= businessUnit.Category %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_businessUnit_path(businessUnit), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', businessUnit_path(businessUnit), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New BusinessUnit', new_businessUnit_path, :method => :get, :class => "btn btn-success btn-sm" %>