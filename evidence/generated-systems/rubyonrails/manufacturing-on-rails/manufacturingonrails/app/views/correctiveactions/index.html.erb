<div class="title text-center">
  List of CorrectiveActions
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">capaNumber</th>
			<th style="text-align:center">rootCause</th>
			<th style="text-align:center">correctiveAction</th>
			<th style="text-align:center">verificationDate</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @correctiveActions.each do |correctiveAction| %>
		<tr>   
			<td style="text-align:center">
	  			<%= correctiveAction.capaNumber %>
			</td>
			<td style="text-align:center">
	  			<%= correctiveAction.rootCause %>
			</td>
			<td style="text-align:center">
	  			<%= correctiveAction.correctiveAction %>
			</td>
			<td style="text-align:center">
	  			<%= correctiveAction.verificationDate %>
			</td>
			<td style="text-align:center">
	  			<%= correctiveAction.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_correctiveAction_path(correctiveAction), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', correctiveAction_path(correctiveAction), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New CorrectiveAction', new_correctiveAction_path, :method => :get, :class => "btn btn-success btn-sm" %>