<div class="title text-center">
  List of Employees
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">firstName</th>
			<th style="text-align:center">lastName</th>
			<th style="text-align:center">Role</th>
			<th style="text-align:center">SkillLevel</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @employees.each do |employee| %>
		<tr>   
			<td style="text-align:center">
	  			<%= employee.firstName %>
			</td>
			<td style="text-align:center">
	  			<%= employee.lastName %>
			</td>
			<td style="text-align:center">
	  			<%= employee.Role %>
			</td>
			<td style="text-align:center">
	  			<%= employee.SkillLevel %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_employee_path(employee), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', employee_path(employee), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Employee', new_employee_path, :method => :get, :class => "btn btn-success btn-sm" %>