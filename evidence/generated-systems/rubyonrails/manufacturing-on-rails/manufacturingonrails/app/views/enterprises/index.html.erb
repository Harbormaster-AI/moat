<div class="title text-center">
  List of Enterprises
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">legalName</th>
			<th style="text-align:center">registrationCountry</th>
			<th style="text-align:center">website</th>
			<th style="text-align:center">taxId</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @enterprises.each do |enterprise| %>
		<tr>   
			<td style="text-align:center">
	  			<%= enterprise.name %>
			</td>
			<td style="text-align:center">
	  			<%= enterprise.legalName %>
			</td>
			<td style="text-align:center">
	  			<%= enterprise.registrationCountry %>
			</td>
			<td style="text-align:center">
	  			<%= enterprise.website %>
			</td>
			<td style="text-align:center">
	  			<%= enterprise.taxId %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_enterprise_path(enterprise), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', enterprise_path(enterprise), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Enterprise', new_enterprise_path, :method => :get, :class => "btn btn-success btn-sm" %>