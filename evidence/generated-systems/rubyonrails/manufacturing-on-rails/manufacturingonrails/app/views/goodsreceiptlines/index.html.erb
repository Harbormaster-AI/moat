<div class="title text-center">
  List of GoodsReceiptLines
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">lineNumber</th>
			<th style="text-align:center">receivedQuantity</th>
			<th style="text-align:center">acceptedQuantity</th>
			<th style="text-align:center">rejectedQuantity</th>
			<th style="text-align:center">lot</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @goodsReceiptLines.each do |goodsReceiptLine| %>
		<tr>   
			<td style="text-align:center">
	  			<%= goodsReceiptLine.lineNumber %>
			</td>
			<td style="text-align:center">
	  			<%= goodsReceiptLine.receivedQuantity %>
			</td>
			<td style="text-align:center">
	  			<%= goodsReceiptLine.acceptedQuantity %>
			</td>
			<td style="text-align:center">
	  			<%= goodsReceiptLine.rejectedQuantity %>
			</td>
			<td style="text-align:center">
	  			<%= goodsReceiptLine.lot %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_goodsReceiptLine_path(goodsReceiptLine), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', goodsReceiptLine_path(goodsReceiptLine), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New GoodsReceiptLine', new_goodsReceiptLine_path, :method => :get, :class => "btn btn-success btn-sm" %>