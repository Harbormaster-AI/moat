<div class="title text-center">
  List of InspectionCharacteristics
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">characteristicCode</th>
			<th style="text-align:center">name</th>
			<th style="text-align:center">lowerSpecLimit</th>
			<th style="text-align:center">upperSpecLimit</th>
			<th style="text-align:center">target</th>
			<th style="text-align:center">MeasurementType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @inspectionCharacteristics.each do |inspectionCharacteristic| %>
		<tr>   
			<td style="text-align:center">
	  			<%= inspectionCharacteristic.characteristicCode %>
			</td>
			<td style="text-align:center">
	  			<%= inspectionCharacteristic.name %>
			</td>
			<td style="text-align:center">
	  			<%= inspectionCharacteristic.lowerSpecLimit %>
			</td>
			<td style="text-align:center">
	  			<%= inspectionCharacteristic.upperSpecLimit %>
			</td>
			<td style="text-align:center">
	  			<%= inspectionCharacteristic.target %>
			</td>
			<td style="text-align:center">
	  			<%= inspectionCharacteristic.MeasurementType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_inspectionCharacteristic_path(inspectionCharacteristic), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', inspectionCharacteristic_path(inspectionCharacteristic), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New InspectionCharacteristic', new_inspectionCharacteristic_path, :method => :get, :class => "btn btn-success btn-sm" %>