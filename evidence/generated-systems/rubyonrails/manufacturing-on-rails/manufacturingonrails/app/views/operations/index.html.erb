<div class="title text-center">
  List of Operations
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">operationNumber</th>
			<th style="text-align:center">name</th>
			<th style="text-align:center">setupTime</th>
			<th style="text-align:center">standardCycleTime</th>
			<th style="text-align:center">OperationType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @operations.each do |operation| %>
		<tr>   
			<td style="text-align:center">
	  			<%= operation.operationNumber %>
			</td>
			<td style="text-align:center">
	  			<%= operation.name %>
			</td>
			<td style="text-align:center">
	  			<%= operation.setupTime %>
			</td>
			<td style="text-align:center">
	  			<%= operation.standardCycleTime %>
			</td>
			<td style="text-align:center">
	  			<%= operation.OperationType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_operation_path(operation), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', operation_path(operation), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Operation', new_operation_path, :method => :get, :class => "btn btn-success btn-sm" %>