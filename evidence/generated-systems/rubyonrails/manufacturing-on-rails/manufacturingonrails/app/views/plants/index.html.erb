<div class="title text-center">
  List of Plants
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">plantCode</th>
			<th style="text-align:center">address</th>
			<th style="text-align:center">timeZone</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @plants.each do |plant| %>
		<tr>   
			<td style="text-align:center">
	  			<%= plant.name %>
			</td>
			<td style="text-align:center">
	  			<%= plant.plantCode %>
			</td>
			<td style="text-align:center">
	  			<%= plant.address %>
			</td>
			<td style="text-align:center">
	  			<%= plant.timeZone %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_plant_path(plant), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', plant_path(plant), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Plant', new_plant_path, :method => :get, :class => "btn btn-success btn-sm" %>