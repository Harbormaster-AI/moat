<div class="title text-center">
  List of ProductionLines
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">lineCode</th>
			<th style="text-align:center">LineType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @productionLines.each do |productionLine| %>
		<tr>   
			<td style="text-align:center">
	  			<%= productionLine.name %>
			</td>
			<td style="text-align:center">
	  			<%= productionLine.lineCode %>
			</td>
			<td style="text-align:center">
	  			<%= productionLine.LineType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_productionLine_path(productionLine), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', productionLine_path(productionLine), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ProductionLine', new_productionLine_path, :method => :get, :class => "btn btn-success btn-sm" %>