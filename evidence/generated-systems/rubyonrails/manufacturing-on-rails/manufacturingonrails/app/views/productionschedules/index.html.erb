<div class="title text-center">
  List of ProductionSchedules
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">scheduleNumber</th>
			<th style="text-align:center">horizonStart</th>
			<th style="text-align:center">horizonEnd</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @productionSchedules.each do |productionSchedule| %>
		<tr>   
			<td style="text-align:center">
	  			<%= productionSchedule.scheduleNumber %>
			</td>
			<td style="text-align:center">
	  			<%= productionSchedule.horizonStart %>
			</td>
			<td style="text-align:center">
	  			<%= productionSchedule.horizonEnd %>
			</td>
			<td style="text-align:center">
	  			<%= productionSchedule.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_productionSchedule_path(productionSchedule), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', productionSchedule_path(productionSchedule), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New ProductionSchedule', new_productionSchedule_path, :method => :get, :class => "btn btn-success btn-sm" %>