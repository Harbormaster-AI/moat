<div class="title text-center">
  List of PurchaseOrderLines
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">lineNumber</th>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">unitPrice</th>
			<th style="text-align:center">dueDate</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @purchaseOrderLines.each do |purchaseOrderLine| %>
		<tr>   
			<td style="text-align:center">
	  			<%= purchaseOrderLine.lineNumber %>
			</td>
			<td style="text-align:center">
	  			<%= purchaseOrderLine.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= purchaseOrderLine.unitPrice %>
			</td>
			<td style="text-align:center">
	  			<%= purchaseOrderLine.dueDate %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_purchaseOrderLine_path(purchaseOrderLine), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', purchaseOrderLine_path(purchaseOrderLine), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PurchaseOrderLine', new_purchaseOrderLine_path, :method => :get, :class => "btn btn-success btn-sm" %>