<div class="title text-center">
  List of PurchaseOrders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">poNumber</th>
			<th style="text-align:center">orderDate</th>
			<th style="text-align:center">totalAmount</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @purchaseOrders.each do |purchaseOrder| %>
		<tr>   
			<td style="text-align:center">
	  			<%= purchaseOrder.poNumber %>
			</td>
			<td style="text-align:center">
	  			<%= purchaseOrder.orderDate %>
			</td>
			<td style="text-align:center">
	  			<%= purchaseOrder.totalAmount %>
			</td>
			<td style="text-align:center">
	  			<%= purchaseOrder.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_purchaseOrder_path(purchaseOrder), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', purchaseOrder_path(purchaseOrder), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New PurchaseOrder', new_purchaseOrder_path, :method => :get, :class => "btn btn-success btn-sm" %>