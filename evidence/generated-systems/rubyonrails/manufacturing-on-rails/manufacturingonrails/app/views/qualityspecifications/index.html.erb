<div class="title text-center">
  List of QualitySpecifications
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">specCode</th>
			<th style="text-align:center">name</th>
			<th style="text-align:center">version</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @qualitySpecifications.each do |qualitySpecification| %>
		<tr>   
			<td style="text-align:center">
	  			<%= qualitySpecification.specCode %>
			</td>
			<td style="text-align:center">
	  			<%= qualitySpecification.name %>
			</td>
			<td style="text-align:center">
	  			<%= qualitySpecification.version %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_qualitySpecification_path(qualitySpecification), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', qualitySpecification_path(qualitySpecification), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New QualitySpecification', new_qualitySpecification_path, :method => :get, :class => "btn btn-success btn-sm" %>