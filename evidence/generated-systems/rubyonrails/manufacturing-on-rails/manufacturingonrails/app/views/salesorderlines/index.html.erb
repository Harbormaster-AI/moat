<div class="title text-center">
  List of SalesOrderLines
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">lineNumber</th>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">unitPrice</th>
			<th style="text-align:center">dueDate</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @salesOrderLines.each do |salesOrderLine| %>
		<tr>   
			<td style="text-align:center">
	  			<%= salesOrderLine.lineNumber %>
			</td>
			<td style="text-align:center">
	  			<%= salesOrderLine.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= salesOrderLine.unitPrice %>
			</td>
			<td style="text-align:center">
	  			<%= salesOrderLine.dueDate %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_salesOrderLine_path(salesOrderLine), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', salesOrderLine_path(salesOrderLine), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New SalesOrderLine', new_salesOrderLine_path, :method => :get, :class => "btn btn-success btn-sm" %>