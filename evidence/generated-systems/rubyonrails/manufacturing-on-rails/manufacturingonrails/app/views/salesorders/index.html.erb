<div class="title text-center">
  List of SalesOrders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">orderNumber</th>
			<th style="text-align:center">orderDate</th>
			<th style="text-align:center">totalAmount</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @salesOrders.each do |salesOrder| %>
		<tr>   
			<td style="text-align:center">
	  			<%= salesOrder.orderNumber %>
			</td>
			<td style="text-align:center">
	  			<%= salesOrder.orderDate %>
			</td>
			<td style="text-align:center">
	  			<%= salesOrder.totalAmount %>
			</td>
			<td style="text-align:center">
	  			<%= salesOrder.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_salesOrder_path(salesOrder), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', salesOrder_path(salesOrder), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New SalesOrder', new_salesOrder_path, :method => :get, :class => "btn btn-success btn-sm" %>