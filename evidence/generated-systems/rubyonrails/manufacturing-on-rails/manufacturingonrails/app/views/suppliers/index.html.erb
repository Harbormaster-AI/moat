<div class="title text-center">
  List of Suppliers
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">supplierCode</th>
			<th style="text-align:center">address</th>
			<th style="text-align:center">SupplierTier</th>
			<th style="text-align:center">PaymentTerms</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @suppliers.each do |supplier| %>
		<tr>   
			<td style="text-align:center">
	  			<%= supplier.name %>
			</td>
			<td style="text-align:center">
	  			<%= supplier.supplierCode %>
			</td>
			<td style="text-align:center">
	  			<%= supplier.address %>
			</td>
			<td style="text-align:center">
	  			<%= supplier.SupplierTier %>
			</td>
			<td style="text-align:center">
	  			<%= supplier.PaymentTerms %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_supplier_path(supplier), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', supplier_path(supplier), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Supplier', new_supplier_path, :method => :get, :class => "btn btn-success btn-sm" %>