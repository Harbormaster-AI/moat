<div class="title text-center">
  List of WorkCenters
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">name</th>
			<th style="text-align:center">code</th>
			<th style="text-align:center">capacityPerHour</th>
			<th style="text-align:center">oeeTarget</th>
			<th style="text-align:center">WorkCenterType</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @workCenters.each do |workCenter| %>
		<tr>   
			<td style="text-align:center">
	  			<%= workCenter.name %>
			</td>
			<td style="text-align:center">
	  			<%= workCenter.code %>
			</td>
			<td style="text-align:center">
	  			<%= workCenter.capacityPerHour %>
			</td>
			<td style="text-align:center">
	  			<%= workCenter.oeeTarget %>
			</td>
			<td style="text-align:center">
	  			<%= workCenter.WorkCenterType %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_workCenter_path(workCenter), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', workCenter_path(workCenter), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New WorkCenter', new_workCenter_path, :method => :get, :class => "btn btn-success btn-sm" %>