<div class="title text-center">
  List of WorkOrders
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>
			<th style="text-align:center">workOrderNumber</th>
			<th style="text-align:center">plannedStart</th>
			<th style="text-align:center">plannedEnd</th>
			<th style="text-align:center">quantity</th>
			<th style="text-align:center">priority</th>
			<th style="text-align:center">Status</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @workOrders.each do |workOrder| %>
		<tr>   
			<td style="text-align:center">
	  			<%= workOrder.workOrderNumber %>
			</td>
			<td style="text-align:center">
	  			<%= workOrder.plannedStart %>
			</td>
			<td style="text-align:center">
	  			<%= workOrder.plannedEnd %>
			</td>
			<td style="text-align:center">
	  			<%= workOrder.quantity %>
			</td>
			<td style="text-align:center">
	  			<%= workOrder.priority %>
			</td>
			<td style="text-align:center">
	  			<%= workOrder.Status %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_workOrder_path(workOrder), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', workOrder_path(workOrder), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New WorkOrder', new_workOrder_path, :method => :get, :class => "btn btn-success btn-sm" %>